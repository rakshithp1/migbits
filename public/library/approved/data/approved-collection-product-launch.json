"https://mmrahmanbappi.github.io/100-free-html-templates/\"\n    },\n    {\n     \"@type\": \"ListItem\",\n     \"position\": 2,\n     \"name\": \"Landing Page Templates\",\n     \"item\": \"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/\"\n    },\n    {\n     \"@type\": \"ListItem\",\n     \"position\": 3,\n     \"name\": \"Product Launch Template\",\n     \"item\": \"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/product-launch/\"\n    }\n   ]\n  }\n ]\n}\n</script>\n<style>\n:root{--sg:#DDE3DD;--sg2:#EEF1EE;--gp:#2B2D2F;--am:#FFB000;--gr:#5A5F5B;--ln:#C9D1C9;--h:\"Tomorrow\",system-ui,sans-serif;--b:\"Plus Jakarta Sans\",system-ui,sans-serif}\n*,*::before,*::after{box-sizing:border-box}[hidden]{display:none!important}html{scroll-behavior:smooth}body{margin:0;font-family:var(--b);font-size:17px;line-height:1.6;color:var(--gp);background:var(--sg)}\nimg{max-width:100%;height:auto;display:block}a{color:inherit}h1,h2,h3{font-family:var(--h);font-weight:700;margin:0;line-height:1.02}\n.wrap{max-width:1180px;margin:0 auto;padding:0 22px}.skip{position:absolute;left:-999px}.skip:focus{left:10px;top:10px;background:var(--am);padding:8px;z-index:99}\n:focus-visible{outline:3px solid var(--gp);outline-offset:3px}\n.nav{display:flex;justify-content:space-between;align-items:center;height:76px;position:relative}.logo{font-family:var(--h);font-weight:700;font-size:26px;text-decoration:none}\n.menu{display:flex;gap:24px;list-style:none;margin:0;padding:0;align-items:center;font-weight:500}.menu a{text-decoration:none}.menu .cta{background:var(--gp);color:#fff;padding:9px 18px;border-radius:30px}\n.burger{display:none;background:none;border:2px solid var(--gp);width:44px;height:40px;border-radius:10px;font-size:20px;cursor:pointer}\n.hero{padding:30px 0 70px}.hg{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center}\n.pill{display:inline-block;background:var(--gp);color:var(--am);border-radius:30px;padding:5px 14px;font-weight:700;font-size:15px;margin-bottom:16px}\n.hero h1{font-size:clamp(50px,7vw,100px)}.hero p{font-size:20px;color:var(--gr);max-width:28em;margin:18px 0 22px}\n.cd{display:flex;gap:10px;margin-bottom:24px;flex-wrap:wrap}.cd div{background:#fff;border-radius:14px;padding:10px 14px;min-width:80px;text-align:center}.cd b{display:block;font-family:var(--h);font-size:32px}.cd span{font-size:13px;color:var(--gr)}\n.btn{display:inline-block;background:var(--am);color:var(--gp);text-decoration:none;font:700 17px var(--b);padding:14px 26px;border-radius:40px;border:0;cursor:pointer}.btn.d{background:var(--gp);color:#fff}\n.stage{background:var(--gp);border-radius:30px;padding:24px;color:#fff}.stage svg{width:100%;height:auto;display:block}\n.ctl{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:10px}.ctl label{display:block;font-size:14px;color:#C9CEC9;margin-bottom:4px}.ctl input{width:100%;accent-color:var(--am)}.ctl output{float:right;color:var(--am);font-weight:700}\n.sw{display:flex;gap:8px;margin-top:14px;align-items:center;flex-wrap:wrap;font-size:14px;color:#C9CEC9}.sw button{width:34px;height:34px;border-radius:50%;border:3px solid transparent;cursor:pointer}.sw button[aria-pressed=true]{border-color:var(--am)}\nsection{padding:80px 0}.sh{max-width:640px;margin-bottom:30px}.sh h2{font-size:clamp(38px,5vw,64px)}.sh p{color:var(--gr);margin:12px 0 0}\n.ft{background:var(--sg2)}.tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}.tabs button{font:700 16px var(--h);background:#fff;border:0;border-radius:30px;padding:10px 18px;cursor:pointer;color:var(--gp)}.tabs button[aria-pressed=true]{background:var(--gp);color:var(--am)}\n.fp{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center;background:#fff;border-radius:26px;padding:30px}.fp>div{min-width:0}.fp h3{font-size:34px}.fp p{color:var(--gr)}.fp .big{font-family:var(--h);font-size:clamp(70px,10vw,130px);line-height:1;color:var(--am);-webkit-text-stroke:2px var(--gp)}\n.eb .box{background:var(--gp);color:#fff;border-radius:30px;padding:36px;display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center}.eb h2{font-size:clamp(34px,4.4vw,56px);color:var(--am)}.eb p{color:#C9CEC9}\n.stk{height:14px;background:#44474A;border-radius:10px;overflow:hidden;margin:12px 0 6px}.stk i{display:block;height:100%;background:var(--am)}.stk+small{color:#C9CEC9}\n.price{font-family:var(--h);font-size:64px;line-height:1}.price s{font-size:26px;color:#8F948F;margin-left:10px}\n.rf{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.rf input{flex:1 1 200px;font:16px var(--b);padding:13px 18px;border-radius:40px;border:0}.rf label{position:absolute;left:-999px}\n.msg{visibility:hidden;margin:12px 0 0;color:var(--am);font-weight:700}.msg.on{visibility:visible}\nfooter{padding:26px 0;font-size:15px;color:var(--gr)}footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}\n@media (max-width:900px){.hg,.fp,.eb .box{grid-template-columns:1fr}}\n@media (max-width:760px){.burger{display:block}.menu{display:none;position:absolute;top:76px;left:0;right:0;background:var(--sg2);flex-direction:column;align-items:flex-start;padding:18px 22px;z-index:30}.menu.open{display:flex}.ctl{grid-template-columns:1fr}.cd div{min-width:68px}}\n@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}\n\n</style>\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n<!-- Template notice bar: delete this block before you publish your own site -->\n<div id=\"template-bar\" style=\"background:#111;color:#fff;font:500 14px/1.4 system-ui,sans-serif;text-align:center;padding:9px 16px\">Free HTML template. <a href=\"index.html\" download=\"product-launch.html\" style=\"color:#FFD166;font-weight:700\">Download this template (free)</a> &nbsp;|&nbsp; <a href=\"https://mmrahmanbappi.github.io/100-free-html-templates/\" style=\"color:#fff\">See all free templates</a></div>\n<header><nav class=\"wrap nav\" aria-label=\"Main\"><a href=\"#\" class=\"logo\">lumo</a><ul class=\"menu\" id=\"menu\"><li><a href=\"#try\">Try it</a></li><li><a href=\"#features\">Features</a></li><li><a href=\"#reserve\" class=\"cta\">Reserve yours</a></li></ul><button class=\"burger\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"menu\">☰</button></nav></header>\n<main id=\"main\">\n<section class=\"hero\" id=\"try\" aria-labelledby=\"h1\"><div class=\"wrap hg\"><div><span class=\"pill\">Launching 1 December</span><h1 id=\"h1\">The desk lamp that follows the sun.</h1><p>Lumo shifts from cool daylight in the morning to warm amber at night, so your eyes feel less tired after a long day at the screen.</p>\n<div class=\"cd\" aria-label=\"Countdown to launch\"><div><b id=\"cD\">0</b><span>days</span></div><div><b id=\"cH\">0</b><span>hours</span></div><div><b id=\"cM\">0</b><span>minutes</span></div></div><a class=\"btn\" href=\"#reserve\">Reserve for $89</a></div>\n<div class=\"stage\"><svg viewBox=\"0 0 400 300\" role=\"img\" aria-label=\"Lumo lamp shining light onto a desk\"><defs><radialGradient id=\"lg\" cx=\"50%\" cy=\"0%\" r=\"100%\"><stop id=\"s1\" offset=\"0%\" stop-color=\"#FFE3A8\" stop-opacity=\".9\"/><stop offset=\"100%\" stop-color=\"#FFE3A8\" stop-opacity=\"0\"/></radialGradient></defs>\n<path id=\"cone\" d=\"M232 92 150 260h200z\" fill=\"url(#lg)\"/><rect x=\"40\" y=\"258\" width=\"320\" height=\"10\" rx=\"4\" fill=\"#5A5F5B\"/><rect x=\"90\" y=\"248\" width=\"70\" height=\"10\" rx=\"3\" fill=\"#44474A\"/><path id=\"arm\" d=\"M125 248V150l100-60\" stroke=\"#DDE3DD\" stroke-width=\"10\" fill=\"none\" stroke-linecap=\"round\"/><path id=\"head\" d=\"M205 78h60l-8 18h-44z\" fill=\"#DDE3DD\"/><circle cx=\"125\" cy=\"150\" r=\"9\" fill=\"#FFB000\"/><rect x=\"250\" y=\"236\" width=\"60\" height=\"22\" rx=\"3\" fill=\"#F2F2F2\" opacity=\".8\"/><rect x=\"190\" y=\"244\" width=\"46\" height=\"14\" rx=\"2\" fill=\"#B8C0B8\" opacity=\".8\"/></svg>\n<div class=\"ctl\"><div><label for=\"ct\">Colour <output id=\"cto\" for=\"ct\">4000K</output></label><input id=\"ct\" type=\"range\" min=\"2200\" max=\"6500\" step=\"100\" value=\"4000\"></div><div><label for=\"br\">Brightness <output id=\"bro\" for=\"br\">70%</output></label><input id=\"br\" type=\"range\" min=\"10\" max=\"100\" value=\"70\"></div></div>\n<div class=\"sw\" role=\"group\" aria-label=\"Lamp finish\"><span>Finish:</span><button type=\"button\" style=\"background:#DDE3DD\" aria-pressed=\"true\" data-c=\"#DDE3DD\" aria-label=\"Sage\"></button><button type=\"button\" style=\"background:#E8DCC8\" aria-pressed=\"false\" data-c=\"#E8DCC8\" aria-label=\"Sand\"></button><button type=\"button\" style=\"background:#6B6F72\" aria-pressed=\"false\" data-c=\"#6B6F72\" aria-label=\"Graphite\"></button><span id=\"fn\">Sage</span></div></div></div></section>\n\n<section class=\"ft\" id=\"features\" aria-labelledby=\"f1\"><div class=\"wrap\"><div class=\"sh\"><h2 id=\"f1\">Small lamp, lots of thought</h2><p>Tap through the features.</p></div><div class=\"tabs\" id=\"tabs\" role=\"group\" aria-label=\"Features\"></div><div class=\"fp\" aria-live=\"polite\"><div><h3 id=\"fh\"></h3><p id=\"fd\"></p></div><div class=\"big\" id=\"fb\"></div></div></div></section>\n\n<section class=\"eb\" id=\"reserve\" aria-labelledby=\"r1\"><div class=\"wrap\"><div class=\"box\"><div><h2 id=\"r1\">Early bird: $89</h2><p>Reserve now for a $10 deposit. Pay the rest when it ships in January. Change your mind any time and we refund the deposit.</p><div class=\"stk\" aria-hidden=\"true\"><i id=\"sb\"></i></div><small id=\"sn\" aria-live=\"polite\"></small></div>\n<div><div class=\"price\">$89<s>$129</s></div><form class=\"rf\" id=\"rf\"><label for=\"re\">Email address</label><input id=\"re\" type=\"email\" placeholder=\"Your email\" required autocomplete=\"email\"><button class=\"btn\" type=\"submit\">Reserve for $10</button></form><p class=\"msg\" id=\"msg\" role=\"status\"></p></div></div></div></section>\n</main>\n<footer><div class=\"wrap\"><p>© <span id=\"yr\"></span> Lumo Lighting Co., Copenhagen</p><p><a href=\"https://unsplash.com\">Photos: Unsplash</a> &nbsp;|&nbsp; <a href=\"https://mmrahmanbappi.github.io/100-free-html-templates/\">More free templates</a></p></div></footer>\n<script>\n(()=>{const $=id=>document.getElementById(id);const L=new Date('2026-12-01T09:00:00');\nfunction cd(){const s=Math.max(0,Math.floor((L-new Date())/1000));$('cD').textContent=Math.floor(s/86400);$('cH').textContent=Math.floor(s%86400/3600);$('cM').textContent=Math.floor(s%3600/60)}cd();setInterval(cd,30000);\nfunction kcol(k){const t=(k-2200)/4300;const r=255,g=Math.round(170+t*80),b=Math.round(70+t*185);return`rgb(${r},${g},${b})`}\nfunction lamp(){const k=+$('ct').value,br=+$('br').value;$('cto').textContent=k+'K';$('bro').textContent=br+'%';$('s1').setAttribute('stop-color',kcol(k));$('s1').setAttribute('stop-opacity',(br/100*.95).toFixed(2))}\n['ct','br'].forEach(i=>$(i).addEventListener('input',lamp));lamp();\ndocument.querySelector('.sw').onclick=e=>{const b=e.target.closest('button');if(!b)return;document.querySelectorAll('.sw button').forEach(x=>x.setAttribute('aria-pressed',x===b));$('arm').setAttribute('stroke',b.dataset.c);$('head').setAttribute('fill',b.dataset.c);$('fn').textContent=b.getAttribute('aria-label')};\nconst F=[[\"Follows the sun\",\"Lumo checks the time and slowly warms its light through the evening. Or set your own schedule in the app.\",\"6500K\"],[\"No flicker\",\"Our driver keeps light steady, so no headaches from invisible flicker on long days.\",\"0%\"],[\"Wireless charging\",\"Drop your phone on the base and it charges while you work.\",\"15W\"],[\"Made to last\",\"Aluminium body, replaceable LED module and a 5-year warranty.\",\"5 yrs\"]];let fi=0;\nfunction ft(){$('tabs').innerHTML=F.map((f,i)=>`<button type=\"button\" aria-pressed=\"${i===fi}\" data-i=\"${i}\">${f[0]}</button>`).join('');$('fh').textContent=F[fi][0];$('fd').textContent=F[fi][1];$('fb').textContent=F[fi][2]}\n$('tabs').onclick=e=>{const b=e.target.closest('button');if(!b)return;fi=+b.dataset.i;ft()};ft();\nlet left=412;const tot=500;function stk(){$('sb').style.width=(tot-left)/tot*100+'%';$('sn').textContent=`${left} of ${tot} early bird lamps left`}stk();\n$('rf').onsubmit=e=>{e.preventDefault();left=Math.max(0,left-1);stk();$('msg').textContent=\"You're on the early bird list. We'll email you a link to pay the $10 deposit.\";$('msg').classList.add('on');$('re').value=''};\n})();\n</script>\n<script>\n(()=>{const b=document.querySelector('.burger'),m=document.getElementById('menu'),y=document.getElementById('yr');\nif(b&&m){b.addEventListener('click',()=>{const o=m.classList.toggle('open');b.setAttribute('aria-expanded',o)});\nm.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{m.classList.remove('open');b.setAttribute('aria-expanded',false)}))}\nif(y)y.textContent=new Date().getFullYear()})();\n</script>\n</body>\n</html>\n",
