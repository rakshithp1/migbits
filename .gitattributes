* text=auto
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Preserve generated bundles, including significant whitespace in template literals.
public/imported/**/previews/*.html -text -diff
# Preserve upstream font notices byte-for-byte, including original whitespace.
public/library/fonts/*-OFL.txt -text -whitespace

# Reviewed originals and tested artifacts must retain the exact bytes whose
# SHA256 values were verified, including on Windows checkouts.
resources/approved/**/original/** -text -whitespace
public/library/approved/** -text -whitespace
public/r/*.json -text
