entListener('resize',apply);addEventListener('focus',apply);addEventListener('message',e=>{if(e.source===parent&&e.data?.type==='migbits-motion-policy'&&typeof e.data.paused==='boolean'){parentPaused=e.data.paused;apply()}});document.querySelectorAll('[data-reference]').forEach(b=>b.onclick=()=>{const mode=b.dataset.reference;document.querySelectorAll('[data-reference]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.querySelectorAll('[data-media]').forEach(x=>x.hidden=x.dataset.media!==mode);apply()});document.getElementById('root')?.addEventListener('click',event=>{const target=event.target.closest('button,a');if(!target||target.hasAttribute('aria-expanded'))return;event.preventDefault();const status=document.querySelector('[role=status]');if(status)status.textContent='Demo only. Connect your own service to enable this action.'});apply();document.body.dataset.previewState='rendered'})();</script></body></html>",
