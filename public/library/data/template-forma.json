      "path": "index.html",
      "content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Forma — Studio portfolio</title><meta name=\"description\" content=\"An editorial portfolio with a project filter and contact form.\"><style>\n*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg,#fbfbfa);color:var(--ink,#25232d);font:15px/1.6 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select{font:inherit}button,a,input,select{outline-offset:4px}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid var(--accent)}.wrap{width:min(1140px,90%);margin:auto}\n.top{height:84px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid #8882}.brand{font-size:24px;letter-spacing:-1px;font-weight:800}.brand span{color:var(--accent);margin-right:8px}.links{display:flex;align-items:center;gap:28px;font-size:13px}.pill{border:1px solid #8884;border-radius:8px;padding:10px 18px;display:inline-flex;align-items:center;justify-content:center;gap:8px;background:transparent;color:inherit}.solid{background:var(--accent);color:var(--button-ink,#fff);border-color:transparent}\n.eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:11px;font-weight:700;color:var(--muted,#777)}h1{font-size:clamp(40px,6.5vw,82px);letter-spacing:-.065em;line-height:1.06;margin:18px 0 26px;font-weight:600}h1 em{font-family:Georgia,serif;font-weight:400}h2{font-size:34px;letter-spacing:-1.3px;line-height:1.2}h3{font-size:19px;letter-spacing:-.4px}.muted{color:var(--muted,#777)}\n.hero{padding:75px 0 60px;display:grid;grid-template-columns:1.05fr 1fr;align-items:center;gap:54px}.hero p{max-width:480px;font-size:17px}.hero-art{border-radius:22px;overflow:hidden}.hero-art svg{width:100%;display:block}.actions{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}.section{padding:45px 0}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.card{border:1px solid #8883;border-radius:14px;padding:26px;background:var(--card,#fff);min-width:0}.card h3{margin:10px 0}.card p{font-size:14px}.number{font:32px Georgia,serif;color:var(--accent)}.price{font-size:46px;letter-spacing:-2px}.price small{font-size:13px;letter-spacing:0}.features{padding-left:18px;font-size:14px;line-height:2.3}\n.form-row{display:flex;gap:10px;flex-wrap:wrap}.form-row input,.search{padding:12px 16px;border:1px solid #8884;border-radius:8px;background:var(--card,#fff);color:inherit;min-width:0}.footer{border-top:1px solid #8883;margin-top:54px;padding:28px 0;display:flex;gap:20px;justify-content:space-between;font-size:12px}.filters{display:flex;gap:8px;flex-wrap:wrap;margin:26px 0}.filters button{border:1px solid #8884;border-radius:30px;padding:8px 16px;background:transparent;color:inherit}.filters button[aria-pressed=true]{background:var(--ink,#25232d);color:var(--bg,#fbfbfa)}\n.art{border-radius:10px;overflow:hidden;margin:-10px -10px 20px}.art svg{display:block;width:100%;height:210px}.project-card{padding:20px}.label{display:inline-flex;padding:4px 9px;border-radius:4px;background:#8881;font-size:11px}.dashboard{display:grid;grid-template-columns:210px minmax(0,1fr);min-height:100vh}.sidebar{padding:30px 22px;border-right:1px solid #8882;background:#fff}.sidebar .brand{margin-bottom:38px}.sidebar button{display:block;width:100%;border:0;border-radius:8px;padding:12px 14px;text-align:left;margin:4px 0;background:transparent;color:#777;font-size:13px}.sidebar button.active{background:#e7f3ee;color:#166c58}\n.dashboard-main{padding:24px 36px;min-width:0}.dash-head{display:flex;gap:14px;justify-content:space-between;align-items:center;margin-bottom:26px}.dash-head h1{font-size:30px;margin:0}.stat strong{display:block;font-size:30px;letter-spacing:-1px}.trend{font-size:11px;color:#16876a}.chart{padding:30px;margin-top:22px;border-radius:14px;border:1px solid #8882;background:white}.chart svg{display:block;width:100%;height:240px}.activity{width:100%;border-collapse:collapse;font-size:13px}.activity td,.activity th{text-align:left;padding:14px 10px;border-bottom:1px solid #8882}.table-scroll{overflow:auto}\n.article-card h3{font:27px/1.2 Georgia,serif}.article-card p{font-size:14px}.article-card a{text-decoration:underline}.event{--bg:#22212c;--ink:#f4f1f8;--muted:#b4adbd;--card:#2c2b39;--button-ink:#211f2b}.schedule{display:flex;align-items:center;gap:30px;padding:24px 0;border-bottom:1px solid #8883}.schedule time{font-size:22px;color:var(--accent);min-width:85px}.cart-total{border:1px solid #8884;border-radius:10px;padding:18px;margin:24px 0;display:flex;align-items:center;gap:18px;flex-wrap:wrap}.product-price{font-weight:700;font-size:19px}.contact{max-width:660px}.contact label{display:block;margin-bottom:12px}.contact input{display:block;width:100%;margin-top:5px}.status{min-height:24px;font-size:13px;color:var(--accent)}[hidden]{display:none!important}\n@media(max-width:720px){.hero{grid-template-columns:1fr;padding-top:45px;gap:24px}.hero-art{max-width:500px}.grid{grid-template-columns:1fr}.links{gap:12px;flex-wrap:wrap;font-size:11px;justify-content:flex-end}.top{height:auto;min-height:84px;padding:15px 0;align-items:flex-start}.links .pill{padding:6px 10px}.dashboard{grid-template-columns:1fr}.sidebar{border-right:0;border-bottom:1px solid #8882;padding:16px 5%}.sidebar .brand{margin-bottom:12px}.sidebar button{display:inline-block;width:auto;margin:0;font-size:11px;padding:8px}.dashboard-main{padding:22px 5%}.dashboard .grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.dashboard .stat{padding:15px 10px}.stat strong{font-size:23px}.stat p{font-size:10px}.dash-head{align-items:flex-start;flex-direction:column}.footer{flex-direction:column;gap:7px}.chart{padding:15px}.activity{min-width:500px}.event h1{font-size:55px}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}}\n</style></head><body  style=\"--accent:#E7844B;--bg:#f6f3ed;\"><header class=\"top wrap\"><a class=\"brand\" href=\"#\"><span>✳</span>forma.</a><nav class=\"links\" aria-label=\"Main navigation\"><a href=\"#work\">Selected work</a><a href=\"#about\">About</a><a class=\"pill\" href=\"#contact\">Say hello ↗</a></nav></header><main class=\"wrap\"><section class=\"hero\"><div><span class=\"eyebrow\">INDEPENDENT DESIGN STUDIO</span><h1>Less noise.<br/><em>More meaning.</em></h1><p class=\"muted\">We turn thoughtful ideas into useful identities, websites and digital experiences.</p><a class=\"pill solid\" href=\"#work\">Explore our work ↓</a></div><div class=\"hero-art\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 480 360\" fill=\"none\" role=\"img\" aria-label=\"Make it your own\"><title>Make it your own</title><metadata>Original Migbits illustration. Copyright (c) 2026 Migbits contributors. MIT License. Source and complete license are included in the download package.</metadata><rect width=\"480\" height=\"360\" rx=\"24\" fill=\"#F7F5FC\"/><ellipse cx=\"240\" cy=\"328\" rx=\"170\" ry=\"13\" fill=\"#E7E1F3\"/><g stroke-linecap=\"round\" stroke-linejoin=\"round\"><g transform=\"rotate(-12 240 180)\"><rect x=\"104\" y=\"104\" width=\"183\" height=\"147\" rx=\"14\" fill=\"#DBECAD\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M125 132h105m-105 20h77\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><g transform=\"rotate(8 240 180)\"><rect x=\"199\" y=\"116\" width=\"176\" height=\"152\" rx=\"14\" fill=\"#FFFFFF\" stroke=\"#302B46\" stroke-width=\"3\"/><rect x=\"218\" y=\"137\" width=\"139\" height=\"73\" rx=\"9\" fill=\"#8B6CF8\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M220 228h109m-109 18h71\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><path d=\"m141 289 116-144 22 17-116 144-29 13Z\" fill=\"#FFD3AE\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"m246 159 22 17m-127 113 22 17\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"370\" cy=\"80\" r=\"16\" fill=\"#FFD3AE\" stroke=\"#302B46\" stroke-width=\"3\"/></g></svg></div></section><section class=\"section\" id=\"work\"><span class=\"eyebrow\">A FEW THINGS WE MADE</span><h2>Selected, with care.</h2><div class=\"filters\" aria-label=\"Filter\"><button type=\"button\" data-filter=\"all\" data-group=\"items\" aria-pressed=\"true\">All</button><button type=\"button\" data-filter=\"brand\" data-group=\"items\" aria-pressed=\"false\">Brand</button><button type=\"button\" data-filter=\"digital\" data-group=\"items\" aria-pressed=\"false\">Digital</button></div><div class=\"grid\"><article class=\"card project-card\" data-item data-group=\"items\" data-kind=\"brand\"><div class=\"art\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 480 360\" fill=\"none\" role=\"img\" aria-label=\"Room for an idea\"><title>Room for an idea</title><metadata>Original Migbits illustration. Copyright (c) 2026 Migbits contributors. MIT License. Source and complete license are included in the download package.</metadata><rect width=\"480\" height=\"360\" rx=\"24\" fill=\"#F7F5FC\"/><ellipse cx=\"240\" cy=\"328\" rx=\"170\" ry=\"13\" fill=\"#E7E1F3\"/><g stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M187 217q-54-65-13-114 48-56 112-20 77 43 15 132-23 18-22 39h-70q1-19-22-37\" fill=\"#FFD3AE\" stroke=\"#302B46\" stroke-width=\"3\"/><rect x=\"206\" y=\"252\" width=\"76\" height=\"28\" rx=\"6\" fill=\"#8B6CF8\" stroke=\"#302B46\" stroke-width=\"3\"/><rect x=\"214\" y=\"280\" width=\"60\" height=\"20\" rx=\"5\" fill=\"#DBECAD\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M226 250v-67l-21-22m58 89v-67l21-22m-57 23h35M243 40V22m106 54 15-15M130 74l-16-16M359 166h24M98 166h24\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"342\" cy=\"272\" r=\"24\" fill=\"#DBECAD\" stroke=\"#302B46\" stroke-width=\"3\"/><circle cx=\"133\" cy=\"249\" r=\"15\" fill=\"#8B6CF8\" stroke=\"#302B46\" stroke-width=\"3\"/></g></svg></div><span class=\"label\">Brand</span><h3>A new perspective</h3><p class=\"muted\">Strategy, identity and a few unexpected details.</p></article><article class=\"card project-card\" data-item data-group=\"items\" data-kind=\"digital\"><div class=\"art\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 480 360\" fill=\"none\" role=\"img\" aria-label=\"A little workspace\"><title>A little workspace</title><metadata>Original Migbits illustration. Copyright (c) 2026 Migbits contributors. MIT License. Source and complete license are included in the download package.</metadata><rect width=\"480\" height=\"360\" rx=\"24\" fill=\"#F7F5FC\"/><ellipse cx=\"240\" cy=\"328\" rx=\"170\" ry=\"13\" fill=\"#E7E1F3\"/><g stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"105\" y=\"90\" width=\"270\" height=\"178\" rx=\"14\" fill=\"#FFFFFF\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M106 124h268\" stroke=\"#302B46\" stroke-width=\"3\"/><circle cx=\"123\" cy=\"108\" r=\"3\" fill=\"#302B46\"/><circle cx=\"137\" cy=\"108\" r=\"3\" fill=\"#302B46\"/><circle cx=\"151\" cy=\"108\" r=\"3\" fill=\"#302B46\"/><rect x=\"127\" y=\"145\" width=\"101\" height=\"98\" rx=\"8\" fill=\"#8B6CF8\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M245 153h101m-101 22h76m-76 22h88m-88 22h58\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M221 269v27m38-27v27m-60 1h82M74 306h332M99 309v34m281-34v34\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><rect x=\"335\" y=\"259\" width=\"47\" height=\"48\" rx=\"8\" fill=\"#DBECAD\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M358 259v-47m0 25q-32 1-28-27 28-1 28 27m0-8q29-5 27-29-25 1-27 29\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g></svg></div><span class=\"label\">Digital</span><h3>A place for progress</h3><p class=\"muted\">Strategy, identity and a few unexpected details.</p></article><article class=\"card project-card\" data-item data-group=\"items\" data-kind=\"brand\"><div class=\"art\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 480 360\" fill=\"none\" role=\"img\" aria-label=\"Better together\"><title>Better together</title><metadata>Original Migbits illustration. Copyright (c) 2026 Migbits contributors. MIT License. Source and complete license are included in the download package.</metadata><rect width=\"480\" height=\"360\" rx=\"24\" fill=\"#F7F5FC\"/><ellipse cx=\"240\" cy=\"328\" rx=\"170\" ry=\"13\" fill=\"#E7E1F3\"/><g stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"166\" cy=\"198\" r=\"30\" fill=\"#FFD3AE\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M137 193q3-45 52-22l10 20q-21-8-31-19-9 18-31 21\" fill=\"#302B46\"/><path d=\"M155 199v2m21-2v2m-15 11q7 7 15 0\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M118 281q0-55 48-55t48 55\" fill=\"#8B6CF8\" stroke=\"#302B46\" stroke-width=\"3\"/><circle cx=\"314\" cy=\"198\" r=\"30\" fill=\"#FFD3AE\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M285 193q3-45 52-22l10 20q-21-8-31-19-9 18-31 21\" fill=\"#302B46\"/><path d=\"M303 199v2m21-2v2m-15 11q7 7 15 0\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M266 281q0-55 48-55t48 55\" fill=\"#DBECAD\" stroke=\"#302B46\" stroke-width=\"3\"/><rect x=\"117\" y=\"71\" width=\"143\" height=\"70\" rx=\"18\" fill=\"#FFFFFF\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M137 96h94m-94 22h57\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m230 141 9 20 4-22\" fill=\"white\" stroke=\"#302B46\" stroke-width=\"3\"/><rect x=\"268\" y=\"108\" width=\"95\" height=\"49\" rx=\"16\" fill=\"#FFD3AE\" stroke=\"#302B46\" stroke-width=\"3\"/><circle cx=\"287\" cy=\"132\" r=\"3\" fill=\"#302B46\" stroke=\"#302B46\" stroke-width=\"3\"/><circle cx=\"309\" cy=\"132\" r=\"3\" fill=\"#302B46\" stroke=\"#302B46\" stroke-width=\"3\"/><circle cx=\"331\" cy=\"132\" r=\"3\" fill=\"#302B46\" stroke=\"#302B46\" stroke-width=\"3\"/></g></svg></div><span class=\"label\">Brand</span><h3>Something that connects</h3><p class=\"muted\">Strategy, identity and a few unexpected details.</p></article></div></section><section class=\"section\" id=\"about\"><h2>Small team. Wide perspective.</h2><p class=\"muted contact\">From first conversation to final detail, good work starts with understanding.</p></section><section class=\"section\" id=\"contact\"><h2>Have something in mind?</h2><form><div class=\"form-row\"><input type=\"email\" required placeholder=\"you@yourstudio.com\" aria-label=\"Email address\"><button class=\"pill solid\">Start a conversation ↗</button></div><p role=\"status\" class=\"status\" aria-live=\"polite\"></p></form></section></main><footer class=\"footer wrap\"><span>Forma · An original Migbits template</span><span>Built with a little care. © 2026</span></footer><script>(function(){\nfunction applyVisibility(){var search=document.querySelector('[data-search]');var query=search?search.value.toLowerCase():'';document.querySelectorAll('[data-item],[data-search-item]').forEach(function(item){var active=document.querySelector('[data-filter][data-group=\"'+(item.dataset.group||'items')+'\"][aria-pressed=\"true\"]');var matchesType=!active||active.dataset.filter==='all'||item.dataset.kind===active.dataset.filter;var matchesSearch=!item.hasAttribute('data-search-item')||item.textContent.toLowerCase().includes(query);item.hidden=!matchesType||!matchesSearch})}\ndocument.querySelectorAll('[data-filter]').forEach(function(button){button.addEventListener('click',function(){var group=button.dataset.group||'items';document.querySelectorAll('[data-filter][data-group=\"'+group+'\"]').forEach(function(b){b.setAttribute('aria-pressed',String(b===button))});applyVisibility()})});\ndocument.querySelectorAll('[data-search]').forEach(function(input){input.addEventListener('input',applyVisibility)});\ndocument.querySelectorAll('.sidebar button').forEach(function(button){button.addEventListener('click',function(){document.querySelectorAll('.sidebar button').forEach(function(b){b.classList.toggle('active',b===button)});document.querySelector('[data-dashboard-title]').textContent=button.textContent.trim();document.querySelector('[data-dashboard-status]').textContent=button.textContent.trim()+' demo view selected.'})});\nvar count=0,total=0;document.querySelectorAll('[data-add-cart]').forEach(function(button){button.addEventListener('click',function(){count++;total+=Number(button.dataset.price);document.querySelector('[data-cart-count]').textContent=String(count);document.querySelector('[data-cart-total]').textContent='$'+total.toFixed(2);button.textContent='Added ✓';setTimeout(function(){button.textContent='Add to cart'},900)})});\ndocument.querySelectorAll('form').forEach(function(form){form.addEventListener('submit',function(event){event.preventDefault();var status=form.querySelector('[role=\"status\"]');if(status)status.textContent='Thanks! This is a frontend template preview; no information has been sent.'})});\ndocument.querySelectorAll('[data-demo-checkout]').forEach(function(button){button.addEventListener('click',function(){document.querySelector('[data-cart-status]').textContent='Demo checkout. Connect a payment provider before launching your store.'})});\n})();</script></body></html>"
