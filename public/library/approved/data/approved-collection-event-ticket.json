      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Free Event Ticket Page Template (HTML) | Night Market Live</title>\n<meta name=\"description\" content=\"Free single event ticket page template in one HTML file. Line-up, doors countdown, ticket tiers with quantity picker, promo code, fees and a live total.\">\n<meta name=\"keywords\" content=\"event ticket page template, concert landing page HTML free, event registration page template, ticket sales page, free HTML template, one page website template\">\n<meta name=\"robots\" content=\"index, follow, max-image-preview:large\">\n<link rel=\"canonical\" href=\"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/\">\n<meta name=\"theme-color\" content=\"#1A0B2E\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:site_name\" content=\"Free HTML Templates\">\n<meta property=\"og:title\" content=\"Free Event Ticket Landing Page Template (HTML)\">\n<meta property=\"og:description\" content=\"Free single event ticket page template in one HTML file. Line-up, doors countdown, ticket tiers with quantity picker, promo code, fees and a live total.\">\n<meta property=\"og:url\" content=\"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/\">\n<meta property=\"og:image\" content=\"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/screenshot.png\"><meta property=\"og:image:alt\" content=\"Free Event Ticket Landing Page Template (HTML)\">\n<meta property=\"og:image:width\" content=\"1440\">\n<meta property=\"og:image:height\" content=\"900\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"Free Event Ticket Landing Page Template (HTML)\">\n<meta name=\"twitter:description\" content=\"Free single event ticket page template in one HTML file. Line-up, doors countdown, ticket tiers with quantity picker, promo code, fees and a live total.\">\n<meta name=\"twitter:image\" content=\"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/screenshot.png\">\n<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='10' fill='%231A0B2E'/><path d='M10 22h44v6a4 4 0 0 0 0 8v6H10v-6a4 4 0 0 0 0-8z' fill='%23FF2E88'/></svg>\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"preconnect\" href=\"https://images.unsplash.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Monoton&family=Golos+Text:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<!-- Structured data for this template page. When you use the template, replace it with LocalBusiness or Organization schema for your own business (see README). -->\n<script type=\"application/ld+json\">\n{\n \"@context\": \"https://schema.org\",\n \"@graph\": [\n  {\n   \"@type\": \"WebPage\",\n   \"@id\": \"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/#webpage\",\n   \"url\": \"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/\",\n   \"name\": \"Free Event Ticket Landing Page Template (HTML)\",\n   \"description\": \"Free single event ticket page template in one HTML file. Line-up, doors countdown, ticket tiers with quantity picker, promo code, fees and a live total.\",\n   \"inLanguage\": \"en\",\n   \"primaryImageOfPage\": {\n    \"@type\": \"ImageObject\",\n    \"url\": \"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/screenshot.png\"\n   },\n   \"isPartOf\": {\n    \"@type\": \"WebSite\",\n    \"name\": \"Free HTML Templates\",\n    \"url\": \"https://mmrahmanbappi.github.io/100-free-html-templates/\"\n   },\n   \"breadcrumb\": {\n    \"@id\": \"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/#breadcrumb\"\n   },\n   \"mainEntity\": {\n    \"@id\": \"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/#template\"\n   }\n  },\n  {\n   \"@type\": \"CreativeWork\",\n   \"@id\": \"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/#template\",\n   \"name\": \"Free Event Ticket Landing Page Template (HTML)\",\n   \"description\": \"Free single event ticket page template in one HTML file. Line-up, doors countdown, ticket tiers with quantity picker, promo code, fees and a live total.\",\n   \"genre\": \"Website template\",\n   \"image\": \"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/screenshot.png\",\n   \"url\": \"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/\",\n   \"license\": \"https://opensource.org/licenses/MIT\",\n   \"isAccessibleForFree\": true,\n   \"encodingFormat\": \"text/html\",\n   \"inLanguage\": \"en\",\n   \"keywords\": \"event ticket page template, concert landing page HTML free, event registration page template, ticket sales page\",\n   \"author\": {\n    \"@type\": \"Person\",\n    \"name\": \"mmrahmanbappi\",\n    \"url\": \"https://github.com/mmrahmanbappi\"\n   },\n   \"offers\": {\n    \"@type\": \"Offer\",\n    \"price\": \"0\",\n    \"priceCurrency\": \"USD\"\n   },\n   \"downloadUrl\": \"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/index.html\"\n  },\n  {\n   \"@type\": \"BreadcrumbList\",\n   \"@id\": \"https://mmrahmanbappi.github.io/100-free-html-templates/landing-pages/event-ticket/#breadcrumb\",\n   \"itemListElement\": [\n    {\n     \"@type\": \"ListItem\",\n     \"position\": 1,\n     \"name\": \"Free HTML Templates\",\n     \"item\": \"https://mmrahmanbappi.github.io/100-free-html-templates/\"\n    },\n    {\n     \"@type\": \"ListItem\",\n     \"position\": 2,\n     \"name\"