      "path": "index.html",
      "content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Gather — Event landing page</title><meta name=\"description\" content=\"An event page with a day-by-day schedule and frontend registration.\"><style>\n*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg,#fbfbfa);color:var(--ink,#25232d);font:15px/1.6 Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select{font:inherit}button,a,input,select{outline-offset:4px}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid var(--accent)}.wrap{width:min(1140px,90%);margin:auto}\n.top{height:84px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid #8882}.brand{font-size:24px;letter-spacing:-1px;font-weight:800}.brand span{color:var(--accent);margin-right:8px}.links{display:flex;align-items:center;gap:28px;font-size:13px}.pill{border:1px solid #8884;border-radius:8px;padding:10px 18px;display:inline-flex;align-items:center;justify-content:center;gap:8px;background:transparent;color:inherit}.solid{background:var(--accent);color:var(--button-ink,#fff);border-color:transparent}\n.eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:11px;font-weight:700;color:var(--muted,#777)}h1{font-size:clamp(40px,6.5vw,82px);letter-spacing:-.065em;line-height:1.06;margin:18px 0 26px;font-weight:600}h1 em{font-family:Georgia,serif;font-weight:400}h2{font-size:34px;letter-spacing:-1.3px;line-height:1.2}h3{font-size:19px;letter-spacing:-.4px}.muted{color:var(--muted,#777)}\n.hero{padding:75px 0 60px;display:grid;grid-template-columns:1.05fr 1fr;align-items:center;gap:54px}.hero p{max-width:480px;font-size:17px}.hero-art{border-radius:22px;overflow:hidden}.hero-art svg{width:100%;display:block}.actions{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}.section{padding:45px 0}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.card{border:1px solid #8883;border-radius:14px;padding:26px;background:var(--card,#fff);min-width:0}.card h3{margin:10px 0}.card p{font-size:14px}.number{font:32px Georgia,serif;color:var(--accent)}.price{font-size:46px;letter-spacing:-2px}.price small{font-size:13px;letter-spacing:0}.features{padding-left:18px;font-size:14px;line-height:2.3}\n.form-row{display:flex;gap:10px;flex-wrap:wrap}.form-row input,.search{padding:12px 16px;border:1px solid #8884;border-radius:8px;background:var(--card,#fff);color:inherit;min-width:0}.footer{border-top:1px solid #8883;margin-top:54px;padding:28px 0;display:flex;gap:20px;justify-content:space-between;font-size:12px}.filters{display:flex;gap:8px;flex-wrap:wrap;margin:26px 0}.filters button{border:1px solid #8884;border-radius:30px;padding:8px 16px;background:transparent;color:inherit}.filters button[aria-pressed=true]{background:var(--ink,#25232d);color:var(--bg,#fbfbfa)}\n.art{border-radius:10px;overflow:hidden;margin:-10px -10px 20px}.art svg{display:block;width:100%;height:210px}.project-card{padding:20px}.label{display:inline-flex;padding:4px 9px;border-radius:4px;background:#8881;font-size:11px}.dashboard{display:grid;grid-template-columns:210px minmax(0,1fr);min-height:100vh}.sidebar{padding:30px 22px;border-right:1px solid #8882;background:#fff}.sidebar .brand{margin-bottom:38px}.sidebar button{display:block;width:100%;border:0;border-radius:8px;padding:12px 14px;text-align:left;margin:4px 0;background:transparent;color:#777;font-size:13px}.sidebar button.active{background:#e7f3ee;color:#166c58}\n.dashboard-main{padding:24px 36px;min-width:0}.dash-head{display:flex;gap:14px;justify-content:space-between;align-items:center;margin-bottom:26px}.dash-head h1{font-size:30px;margin:0}.stat strong{display:block;font-size:30px;letter-spacing:-1px}.trend{font-size:11px;color:#16876a}.chart{padding:30px;margin-top:22px;border-radius:14px;border:1px solid #8882;background:white}.chart svg{display:block;width:100%;height:240px}.activity{width:100%;border-collapse:collapse;font-size:13px}.activity td,.activity th{text-align:left;padding:14px 10px;border-bottom:1px solid #8882}.table-scroll{overflow:auto}\n.article-card h3{font:27px/1.2 Georgia,serif}.article-card p{font-size:14px}.article-card a{text-decoration:underline}.event{--bg:#22212c;--ink:#f4f1f8;--muted:#b4adbd;--card:#2c2b39;--button-ink:#211f2b}.schedule{display:flex;align-items:center;gap:30px;padding:24px 0;border-bottom:1px solid #8883}.schedule time{font-size:22px;color:var(--accent);min-width:85px}.cart-total{border:1px solid #8884;border-radius:10px;padding:18px;margin:24px 0;display:flex;align-items:center;gap:18px;flex-wrap:wrap}.product-price{font-weight:700;font-size:19px}.contact{max-width:660px}.contact label{display:block;margin-bottom:12px}.contact input{display:block;width:100%;margin-top:5px}.status{min-height:24px;font-size:13px;color:var(--accent)}[hidden]{display:none!important}\n@media(max-width:720px){.hero{grid-template-columns:1fr;padding-top:45px;gap:24px}.hero-art{max-width:500px}.grid{grid-template-columns:1fr}.links{gap:12px;flex-wrap:wrap;font-size:11px;justify-content:flex-end}.top{height:auto;min-height:84px;padding:15px 0;align-items:flex-start}.links .pill{padding:6px 10px}.dashboard{grid-template-columns:1fr}.sidebar{border-right:0;border-bottom:1px solid #8882;padding:16px 5%}.sidebar .brand{margin-bottom:12px}.sidebar button{display:inline-block;width:auto;margin:0;font-size:11px;padding:8px}.dashboard-main{padding:22px 5%}.dashboard .grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.dashboard .stat{padding:15px 10px}.stat strong{font-size:23px}.stat p{font-size:10px}.dash-head{align-items:flex-start;flex-direction:column}.footer{flex-direction:column;gap:7px}.chart{padding:15px}.activity{min-width:500px}.event h1{font-size:55px}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}}\n\nhtml{scroll-behavior:smooth;scroll-padding-top:80px}body{overflow-x:clip}img{object-fit:cover}\nbody[data-mb-template-edition]{font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n:focus-visible{outline:3px solid #367aff!important;outline-offset:4px}\n.mb-template-motion{position:fixed;bottom:16px;right:16px;z-index:2000;background:#10213c;color:white;border:1px solid #9bbcff66;border-radius:30px;padding:9px 14px;font:12px system-ui;box-shadow:0 5px 24px #0003}\n.mb-template-status{font:13px/1.5 system-ui;color:inherit;margin-top:12px}\n.mb-template-icon{display:inline-block;width:1em;height:1em;vertical-align:-.12em}\n.mb-template-icon svg{width:100%;height:100%;fill:currentColor}\n.mb-template-art{max-width:100%;height:auto}\n.mb-template-zoom{max-width:min(1000px,92vw);border:0;border-radius:14px;padding:10px;background:#101827;color:white}\n.mb-template-zoom::backdrop{background:#050a15ce}.mb-template-zoom img{max-width:100%;max-height:80vh}.mb-template-zoom button{display:block;margin:6px 0 6px auto}\n@media(hover:hover) and (prefers-reduced-motion:no-preference){.btn{transition:box-shadow .25s,filter .25s}.btn:hover{filter:brightness(1.06);box-shadow:0 6px 20px #0002}.card,.portfolio-item{transition:box-shadow .3s}.card:hover,.portfolio-item:hover{box-shadow:0 12px 32px #1636671c}}\nhtml[data-template-motion=paused] *{animation-play-state:paused!important;transition:none!important;scroll-behavior:auto!important}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head><body class=\"event\" style=\"--accent:#B7A2F7;\"><header class=\"top wrap\"><a class=\"brand\" href=\"#\"><span>✳</span>gather / 26</a><nav class=\"links\" aria-label=\"Main navigation\"><a href=\"#schedule\">The schedule</a><a class=\"pill solid\" href=\"#register\">Join us ↗</a></nav></header><main class=\"wrap\"><section class=\"hero\"><div><span class=\"eyebrow\">TWO DAYS OF GOOD CONVERSATION</span><h1>Good people.<br/><em>Better ideas.</em></h1><p class=\"muted\">A gathering for people who build, design and question how things could be a little better.</p><p>November 12–13, 2026 · Online & everywhere</p><a class=\"pill solid\" href=\"#register\">Save your place ↗</a></div><div class=\"hero-art\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 480 360\" fill=\"none\" role=\"img\" aria-label=\"A few good people\"><title>A few good people</title><metadata>Original Migbits illustration. Copyright (c) 2026 Migbits contributors. MIT License. Source and complete license are included in the download package.</metadata><rect width=\"480\" height=\"360\" rx=\"24\" fill=\"#F7F5FC\"/><ellipse cx=\"240\" cy=\"328\" rx=\"170\" ry=\"13\" fill=\"#E7E1F3\"/><g stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M146 236 239 112l99 124Z\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"3\" stroke-dasharray=\"6 9\"/><circle cx=\"239\" cy=\"97\" r=\"30\" fill=\"#FFD3AE\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M210 92q3-45 52-22l10 20q-21-8-31-19-9 18-31 21\" fill=\"#302B46\"/><path d=\"M228 98v2m21-2v2m-15 11q7 7 15 0\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M191 180q0-55 48-55t48 55\" fill=\"#8B6CF8\" stroke=\"#302B46\" stroke-width=\"3\"/><circle cx=\"125\" cy=\"221\" r=\"30\" fill=\"#FFD3AE\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M96 216q3-45 52-22l10 20q-21-8-31-19-9 18-31 21\" fill=\"#302B46\"/><path d=\"M114 222v2m21-2v2m-15 11q7 7 15 0\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M77 304q0-55 48-55t48 55\" fill=\"#FFD3AE\" stroke=\"#302B46\" stroke-width=\"3\"/><circle cx=\"354\" cy=\"221\" r=\"30\" fill=\"#FFD3AE\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M325 216q3-45 52-22l10 20q-21-8-31-19-9 18-31 21\" fill=\"#302B46\"/><path d=\"M343 222v2m21-2v2m-15 11q7 7 15 0\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M306 304q0-55 48-55t48 55\" fill=\"#DBECAD\" stroke=\"#302B46\" stroke-width=\"3\"/><circle cx=\"244\" cy=\"255\" r=\"21\" fill=\"#DBECAD\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M236 255h16m-8-8v16\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g></svg></div></section><section class=\"section\" id=\"schedule\"><span class=\"eyebrow\">MAKE A LITTLE ROOM IN YOUR CALENDAR</span><h2>The conversations.</h2><div class=\"filters\" aria-label=\"Filter\"><button type=\"button\" data-filter=\"all\" data-group=\"schedule\" aria-pressed=\"true\">All</button><button type=\"button\" data-filter=\"day one\" data-group=\"schedule\" aria-pressed=\"false\">Day one</button><button type=\"button\" data-filter=\"day two\" data-group=\"schedule\" aria-pressed=\"false\">Day two</button></div><article class=\"schedule\" data-item data-group=\"schedule\" data-kind=\"day one\"><time>09:00</time><div><h3>A good place to begin</h3><p class=\"muted\">Opening notes and a shared perspective</p></div></article><article class=\"schedule\" data-item data-group=\"schedule\" data-kind=\"day one\"><time>11:00</time><div><h3>The space between ideas</h3><p class=\"muted\">A conversation about making thoughtful things</p></div></article><article class=\"schedule\" data-item data-group=\"schedule\" data-kind=\"day two\"><time>14:00</time><div><h3>Better together</h3><p class=\"muted\">Building practices for collaborative work</p></div></article><article class=\"schedule\" data-item data-group=\"schedule\" data-kind=\"day two\"><time>16:00</time><div><h3>Take something with you</h3><p class=\"muted\">Small ideas to put into practice</p></div></article></section><section class=\"section\" id=\"register\"><h2>There is a place for you.</h2><form><div class=\"form-row\"><input type=\"email\" required placeholder=\"you@yourstudio.com\" aria-label=\"Email address\"><button class=\"pill solid\">Save my place</button></div><p role=\"status\" class=\"status\" aria-live=\"polite\"></p></form></section></main><footer class=\"footer wrap\"><span>Gather · An original Migbits template</span><span>Built with a little care. © 2026</span></footer><script>(function(){\nfunction applyVisibility(){var search=document.querySelector('[data-search]');var query=search?search.value.toLowerCase():'';document.querySelectorAll('[data-item],[data-search-item]').forEach(function(item){var active=document.querySelector('[data-filter][data-group=\"'+(item.dataset.group||'items')+'\"][aria-pressed=\"true\"]');var matchesType=!active||active.dataset.filter==='all'||item.dataset.kind===active.dataset.filter;var matchesSearch=!item.hasAttribute('data-search-item')||item.textContent.toLowerCase().includes(query);item.hidden=!matchesType||!matchesSearch})}\ndocument.querySelectorAll('[data-filter]').forEach(function(button){button.addEventListener('click',function(){var group=button.dataset.group||'items';document.querySelectorAll('[data-filter][data-group=\"'+group+'\"]').forEach(function(b){b.setAttribute('aria-pressed',String(b===button))});applyVisibility()})});\ndocument.querySelectorAll('[data-search]').forEach(function(input){input.addEventListener('input',applyVisibility)});\ndocument.querySelectorAll('.sidebar button').forEach(function(button){button.addEventListener('click',function(){document.querySelectorAll('.sidebar button').forEach(function(b){b.classList.toggle('active',b===button)});document.querySelector('[data-dashboard-title]').textContent=button.textContent.trim();document.querySelector('[data-dashboard-status]').textContent=button.textContent.trim()+' demo view selected.'})});\nvar count=0,total=0;document.querySelectorAll('[data-add-cart]').forEach(function(button){button.addEventListener('click',function(){count++;total+=Number(button.dataset.price);document.querySelector('[data-cart-count]').textContent=String(count);document.querySelector('[data-cart-total]').textContent='$'+total.toFixed(2);button.textContent='Added ✓';setTimeout(function(){button.textContent='Add to cart'},900)})});\ndocument.querySelectorAll('form').forEach(function(form){form.addEventListener('submit',function(event){event.preventDefault();var status=form.querySelector('[role=\"status\"]');if(status)status.textContent='Thanks! This is a frontend template preview; no information has been sent.'})});\ndocument.querySelectorAll('[data-demo-checkout]').forEach(function(button){button.addEventListener('click',function(){document.querySelector('[data-cart-status]').textContent='Demo checkout. Connect a payment provider before launching your store.'})});\n})();</script><script>\n(()=>{\nconst media=matchMedia('(prefers-reduced-motion:reduce)'),active=new Set(),seen=new WeakSet();let paused=false,lastFocus=null;\nconst toggle=document.createElement('button');toggle.className='mb-template-motion';toggle.type='button';document.body.append(toggle);\nconst observer=new IntersectionObserver(entries=>{for(const entry of entries){if(!entry.isIntersecting||paused||media.matches)continue;observer.unobserve(entry.target);if(seen.has(entry.target))continue;seen.add(entry.target);const a=entry.target.animate([{opacity:.78,translate:'0 16px'},{opacity:1,translate:'0 0'}],{duration:700,easing:'cubic-bezier(.16,1,.3,1)'});active.add(a);a.finished.finally(()=>active.delete(a)).catch(()=>{});}},{threshold:.1});\nfunction policy(){const stop=paused||media.matches;document.documentElement.dataset.templateMotion=stop?'paused':'running';toggle.textContent=media.matches?'Reduced motion':paused?'Resume motion':'Pause motion';toggle.disabled=media.matches;toggle.setAttribute('aria-pressed',String(stop));if(stop){active.forEach(a=>a.cancel());active.clear();}else document.querySelectorAll('header .container,section .row,article,.card,.portfolio-item').forEach(el=>{if(!seen.has(el))observer.observe(el);});}\ntoggle.onclick=()=>{paused=!paused;policy()};media.addEventListener('change',policy);policy();\nfunction targetFor(button){const selector=button.getAttribute('data-bs-target')||button.getAttribute('href');return selector&&/^#[a-zA-Z][\\w-]*$/.test(selector)?document.querySelector(selector):null;}\nfunction closeModals(){document.querySelectorAll('.modal.show').forEach(el=>{el.classList.remove('show');el.style.display='none';el.setAttribute('aria-hidden','true');el.removeAttribute('aria-modal');});document.querySelectorAll('.modal-backdrop').forEach(el=>el.remove());lastFocus?.focus();lastFocus=null;}\ndocument.addEventListener('click',event=>{\nconst trigger=event.target.closest('[data-bs-toggle],[data-bs-dismiss]');if(trigger){const kind=trigger.getAttribute('data-bs-toggle'),target=targetFor(trigger);if(kind==='collapse'&&target){event.preventDefault();const show=target.classList.toggle('show');trigger.setAttribute('aria-expanded',String(show));}if(kind==='dropdown'){event.preventDefault();const menu=trigger.parentElement.querySelector('.dropdown-menu');if(menu)trigger.setAttribute('aria-expanded',String(menu.classList.toggle('show')));}if(kind==='modal'&&target){event.preventDefault();lastFocus=trigger;target.classList.add('show');target.style.display='block';target.setAttribute('aria-modal','true');target.removeAttribute('aria-hidden');target.setAttribute('role','dialog');target.tabIndex=-1;target.focus();const backdrop=document.createElement('div');backdrop.className='modal-backdrop fade show';document.body.append(backdrop);}if(trigger.hasAttribute('data-bs-dismiss'))closeModals();}\nconst anchor=event.target.closest('a');if(!anchor)return;const href=anchor.getAttribute('href')||'';\nif(anchor.dataset.mbImage){event.preventDefault();const dialog=document.createElement('dialog');dialog.className='mb-template-zoom';const close=document.createElement('button');close.type='button';close.textContent='Close image';const image=document.createElement('img');image.src=anchor.dataset.mbImage;image.alt='Original MigBits demo artwork';dialog.append(close,image);document.body.append(dialog);close.onclick=()=>dialog.close();dialog.onclose=()=>dialog.remove();dialog.showModal();return;}\nif(/^https?:|^mailto:|^tel:/.test(href)){event.preventDefault();return;}\nif(href.startsWith('#')&&!anchor.hasAttribute('data-bs-toggle'))document.querySelectorAll('.navbar-collapse.show').forEach(el=>{el.classList.remove('show');document.querySelectorAll('.navbar-toggler').forEach(button=>button.setAttribute('aria-expanded','false'));});\n});\ndocument.addEventListener('keydown',event=>{if(event.key==='Escape')closeModals();if(event.key==='Tab'){const modal=document.querySelector('.modal.show');if(!modal)return;const focus=[...modal.querySelectorAll('button,a[href],input,select,textarea,[tabindex=\"0\"]')].filter(el=>!el.disabled&&el.getClientRects().length);if(!focus.length){event.preventDefault();modal.focus();return;}const first=focus[0],last=focus[focus.length-1];if(event.shiftKey&&(document.activeElement===first||document.activeElement===modal)){event.preventDefault();last.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}}});\ndocument.addEventListener('submit',event=>{event.preventDefault();let status=event.target.querySelector('[role=status]');if(!status){status=document.createElement('p');status.setAttribute('role','status');status.className='mb-template-status';event.target.append(status);}status.textContent='Demo only — no information has been sent. Connect your own form backend.';});\ndocument.querySelectorAll('form [type=submit]').forEach(button=>{button.disabled=false;button.classList.remove('disabled')});\ndocument.body.dataset.previewState='rendered';\n})();</script></body></html>"
    },
