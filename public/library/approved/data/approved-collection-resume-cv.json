font-size:15px}.sk .t{height:6px;background:#fff;border-radius:3px;margin-top:4px;overflow:hidden}.sk .t i{display:block;height:100%;background:var(--nv)}\n.lang{display:flex;justify-content:space-between;font-size:15px;margin-bottom:6px}.lang span{color:var(--mu)}\n.main{padding:36px 38px}\n.main h1{font-family:var(--s);font-size:44px}.role{font-size:19px;color:var(--ac);font-weight:700;margin:4px 0 16px}\n.sum{font-size:17px;color:#3B4553;border-left:3px solid var(--ac);padding-left:14px;margin:0 0 26px}\n.main h2{font-family:var(--s);font-size:24px;border-bottom:2px solid var(--nv);padding-bottom:6px;margin:30px 0 14px}\n.job{margin-bottom:20px}.job .top{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}.job h3{font-size:18px;font-family:var(--b)}\n.job .co{color:var(--ac);font-weight:600}.job time{color:var(--mu);font-size:14px;white-space:nowrap}\n.job ul{margin:8px 0 0;padding-left:18px}.job li{margin-bottom:4px}\n.edu{display:flex;justify-content:space-between;gap:10px;margin-bottom:10px;flex-wrap:wrap}.edu b{display:block}.edu span{color:var(--mu);font-size:15px}\n.refs{display:grid;grid-template-columns:1fr 1fr;gap:14px}.refs div{background:var(--nv-l);border-radius:8px;padding:14px;font-size:15px}.refs b{display:block;color:var(--nv)}\n.note{max-width:980px;margin:0 auto 40px;padding:0 22px;color:var(--mu);font-size:14px;text-align:center}\n@media(max-width:820px){.page{grid-template-columns:1fr;margin:0}.main{padding:26px 22px}.refs{grid-template-columns:1fr}.menu{display:none}}\n@media print{body{background:#fff}.bar,.note,#template-bar,.skip{display:none!important}.page{box-shadow:none;margin:0;max-width:none}a{text-decoration:none}@page{margin:12mm}}\n\n</style>\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n<!-- Template notice bar: delete this block before you publish your own site -->\n<div id=\"template-bar\" style=\"background:#111;color:#fff;font:500 14px/1.4 system-ui,sans-serif;text-align:center;padding:9px 16px\">Free HTML template. <a href=\"index.html\" download=\"resume-cv.html\" style=\"color:#FFD166;font-weight:700\">Download this template (free)</a> &nbsp;|&nbsp; <a href=\"https://mmrahmanbappi.github.io/100-free-html-templates/\" style=\"color:#fff\">See all free templates</a></div>\n<div class=\"bar\"><div class=\"in\"><ul class=\"menu\" id=\"menu\"><li><a href=\"#experience\">Experience</a></li><li><a href=\"#education\">Education</a></li><li><a href=\"#references\">References</a></li></ul><div class=\"g\"><button type=\"button\" id=\"pr\">Print or save as PDF</button><a href=\"mailto:aisha.rahman@example.com\">Email me</a></div><button class=\"burger\" aria-label=\"Menu\" aria-controls=\"menu\" aria-expanded=\"false\" hidden></button></div></div>\n<main id=\"main\"><article class=\"page\" aria-labelledby=\"h1\">\n<aside class=\"side\"><img src=\"https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=300&q=80&auto=format&fit=crop\" alt=\"Aisha Rahman\" width=\"140\" height=\"140\">\n<h2>Contact</h2><ul><li>📍 Manchester, UK</li><li>✉️ aisha.rahman@example.com</li><li>📞 +44 7700 900 123</li><li>🔗 linkedin.com/in/aisharahman</li></ul>\n<h2>Skills</h2><div class=\"sk\">Project management<div class=\"t\"><i style=\"width:95%\"></i></div></div><div class=\"sk\">Budget planning<div class=\"t\"><i style=\"width:88%\"></i></div></div><div class=\"sk\">Team leadership<div class=\"t\"><i style=\"width:90%\"></i></div></div><div class=\"sk\">Data analysis (Excel, SQL)<div class=\"t\"><i style=\"width:78%\"></i></div></div><div class=\"sk\">Stakeholder reporting<div class=\"t\"><i style=\"width:85%\"></i></div></div>\n<h2>Languages</h2><div class=\"lang\">English<span>Native</span></div><div class=\"lang\">Bengali<span>Native</span></div><div class=\"lang\">Arabic<span>Good</span></div><div class=\"lang\">French<span>Basic</span></div>\n<h2>Certificates</h2><ul><li>PMP, Project Management Institute, 2021</li><li>PRINCE2 Practitioner, 2019</li><li>Agile Scrum Master, 2018</li></ul></aside>\n<div class=\"main\"><h1 id=\"h1\">Aisha Rahman</h1><div class=\"role\">Senior Project Manager</div>\n<p class=\"sum\">Project manager with 12 years of experience leading construction and public-sector projects worth up to £40 million. Known for calm leadership, clear reporting and bringing projects in on time and under budget.</p>\n<h2 id=\"experience\">Work experience</h2>\n<div class=\"job\"><div class=\"top\"><h3>Senior Project Manager · <span class=\"co\">Northgate Infrastructure</span></h3><time>2021 to present</time></div><ul><li>Lead a team of 14 across 6 projects with a combined value of £96 million.</li><li>Delivered the £38m Riverside school build 5 weeks early and 3% under budget.</li><li>Introduced weekly risk reviews that cut late changes by 40%.</li></ul></div>\n<div class=\"job\"><div class=\"top\"><h3>Project Manager · <span class=\"co\">City of Leeds Council</span></h3><time>2016 to 2021</time></div><ul><li>Managed 22 housing and road projects for the council's regeneration plan.</li><li>Built a reporting dashboard now used by 5 departments.</li></ul></div>\n<div class=\"job\"><div class=\"top\"><h3>Assistant Project Manager · <span class=\"co\">Hale Construction</span></h3><time>2013 to 2016</time></div><ul><li>Supported budgets, schedules and supplier contracts on commercial builds.</li></ul></div>\n<h2 id=\"education\">Education</h2>\n<div class=\"edu\"><div><b>MSc Construction Project Management</b><span>University of Manchester</span></div><span>2012 to 2013</span></div>\n<div class=\"edu\"><div><b>BSc Civil Engineering, First Class</b><span>University of Leeds</span></div><span>2009 to 2012</span></div>\n<h2 id=\"references\">References</h2>\n<div class=\"refs\"><div><b>David Kerr</b>Director, Northgate Infrastructure<br>david.kerr@example.com</div><div><b>Elena Marsh</b>Head of Regeneration, City of Leeds<br>Available on request</div></div></div>\n</article></main>\n<p class=\"note\">Online CV template, a <a href=\"https://mmrahmanbappi.github.io/100-free-html-templates/\">free HTML template</a>. Photo: <a href=\"https://unsplash.com\" rel=\"noopener\">Unsplash</a>. The print button hides this note and the menu bar. © <span id=\"yr\">2026</span></p>\n<script>document.getElementById('pr').onclick=()=>window.print();</script>\n<script>\n(()=>{const b=document.querySelector('.burger'),m=document.getElementById('menu'),y=document.getElementById('yr');\nif(b&&m){b.addEventListener('click',()=>{const o=m.classList.toggle('open');b.setAttribute('aria-expanded',o)});\nm.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{m.classList.remove('open');b.setAttribute('aria-expanded',false)}))}\nif(y)y.textContent=new Date().getFullYear()})();\n</script>\n</body>\n</html>\n",
