USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n\n\n</script></head><body data-preview-state=\"loading\"><main class=\"reference \"><header class=\"head\"><div><h1>MigBits / Prosthetics Hero</h1><p>Design prompt kit · visual reference, not an executed application</p></div><div class=\"controls\"><button data-pause type=\"button\" aria-pressed=\"false\">Pause motion</button></div></header><div class=\"stage\"><video data-media=\"video\"  src=\"https://migbits.com/library/motionsites/media/be71d44eed5568f8a2608a17.mp4\" muted playsinline loop preload=\"metadata\" aria-label=\"MotionSites motion asset reference\"></video></div><footer class=\"reference-foot\"><span>MotionSites design · MigBits adaptation</span><span >Prompt and code excerpts included; full implementation not validated.</span></footer></main><script>(()=>{const root=document.documentElement,media=matchMedia('(prefers-reduced-motion:reduce)'),button=document.querySelector('[data-pause]');let paused=false,parentPaused=false;function apply(){const stop=paused||parentPaused||media.matches||document.hidden;root.dataset.motion=stop?'paused':'running';root.dataset.reduced=String(media.matches);button.textContent=media.matches?'Reduced motion':paused?'Resume motion':'Pause motion';button.disabled=media.matches;button.setAttribute('aria-pressed',String(stop));document.querySelectorAll('video').forEach(v=>{if(stop||v.hidden){v.pause()}else{v.play().catch(()=>{v.dataset.playback='unavailable'})}});document.dispatchEvent(new Event('migbits-preview-motion'))}button.onclick=()=>{paused=!paused;apply()};media.addEventListener('change',apply);document.addEventListener('visibilitychange',apply);addEventListener('resize',apply);addEventListener('focus',apply);addEventListener('message',e=>{if(e.source===parent&&e.data?.type==='migbits-motion-policy'&&typeof e.data.paused==='boolean'){parentPaused=e.data.paused;apply()}});document.querySelectorAll('[data-reference]').forEach(b=>b.onclick=()=>{const mode=b.dataset.reference;document.querySelectorAll('[data-reference]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.querySelectorAll('[data-media]').forEach(x=>x.hidden=x.dataset.media!==mode);apply()});document.getElementById('root')?.addEventListener('click',event=>{const target=event.target.closest('button,a');if(!target||target.hasAttribute('aria-expanded'))return;event.preventDefault();const status=document.querySelector('[role=status]');if(status)status.textContent='Demo only. Connect your own service to enable this action.'});apply();document.body.dataset.previewState='rendered'})();</script></body></html>",
