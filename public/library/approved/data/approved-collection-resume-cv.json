      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Free Resume & CV Website Template (HTML) | Aisha Rahman</title>\n<meta name=\"description\" content=\"Free online resume and CV template in one HTML file. Print or save as PDF in one click, work history, skills, education, languages and references.\">\n<meta name=\"keywords\" content=\"resume website template, online CV HTML template free, printable resume template, personal CV page, free HTML template, one page website template\">\n<meta name=\"robots\" content=\"index, follow, max-image-preview:large\">\n<link rel=\"canonical\" href=\"https://mmrahmanbappi.github.io/100-free-html-templates/portfolio/resume-cv/\">\n<meta name=\"theme-color\" content=\"#1F3A5F\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:site_name\" content=\"Free HTML Templates\">\n<meta property=\"og:title\" content=\"Free Resume and CV Website Template (HTML)\">\n<meta property=\"og:description\" content=\"Free online resume and CV template in one HTML file. Print or save as PDF in one click, work history, skills, education, languages and references.\">\n<meta property=\"og:url\" content=\"https://mmrahmanbappi.github.io/100-free-html-templates/portfolio/resume-cv/\">\n<meta property=\"og:image\" content=\"https://mmrahmanbappi.github.io/100-free-html-templates/portfolio/resume-cv/screenshot.png\"><meta property=\"og:image:alt\" content=\"Free Resume and CV Website Template (HTML)\">\n<meta property=\"og:image:width\" content=\"1440\">\n<meta property=\"og:image:height\" content=\"900\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"Free Resume and CV Website Template (HTML)\">\n<meta name=\"twitter:description\" content=\"Free online resume and CV template in one HTML file. Print or save as PDF in one click, work history, skills, education, languages and references.\">\n<meta name=\"twitter:image\" content=\"https://mmrahmanbappi.github.io/100-free-html-templates/portfolio/resume-cv/screenshot.png\">\n<link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='8' fill='%231F3A5F'/><path d='M18 18h28M18 28h28M18 38h18' stroke='%23fff' stroke-width='5' stroke-linecap='round'/></svg>\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"preconnect\" href=\"https://images.unsplash.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,700&family=Public+Sans:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n<!-- Structured data for this template page. When you use the template, replace it with LocalBusiness or Organization schema for your own business (see README). -->\n<script type=\"application/ld+json\">\n{\n \"@context\": \"https://schema.org\",\n \"@graph\": [\n  {\n   \"@type\": \"WebPage\",\n   \"@id\": \"https://mmrahmanbappi.github.io/100-free-html-templates/portfolio/resume-cv/#webpage\",\n   \"url\": \"https://mmrahmanbappi.github.io/100-free-html-templates/portfolio/resume-cv/\",\n   \"name\": \"Free Resume and CV Website Template (HTML)\",\n   \"description\": \"Free online resume and CV template in one HTML file. Print or save as PDF in one click, work history, skills, education, languages and references.\",\n   \"inLanguage\": \"en\",\n   \"primaryImageOfPage\": {\n    \"@type\": \"ImageObject\",\n    \"url\": \"https://mmrahmanbappi.github.io/100-free-html-templates/portfolio/resume-cv/screenshot.png\"\n   },\n   \"isPartOf\": {\n    \"@type\": \"WebSite\",\n    \"name\": \"Free HTML Templates\",\n    \"url\": \"https://mmrahmanbappi.github.io/100-free-html-templates/\"\n   },\n   \"breadcrumb\": {\n    \"@id\": \"https://mmrahmanbappi.github.io/100-free-html-templates/p