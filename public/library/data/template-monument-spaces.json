      "path": "index.html",
      "content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none';script-src 'unsafe-inline';style-src 'unsafe-inline';img-src data:;connect-src 'none';form-action 'none';base-uri 'none'\"><meta name=\"color-scheme\" content=\"dark\"><title>Monument Spaces — MigBits full-screen template</title><script type=\"text/plain\" id=\"license-notices\">MIT License\n\nCopyright (c) 2026 Migbits contributors\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n</script><style>\n:root{--accent:#c8d5de;--bg:#151b20;--ink:#f2f5f6;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--bg);scroll-behavior:smooth}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}button,input{font:inherit}button,a,input{ -webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:6px}button{cursor:pointer}::selection{background:var(--accent);color:var(--bg)}.skip{position:absolute;top:-80px;left:20px;z-index:10;background:var(--ink);color:var(--bg);padding:14px}.skip:focus{top:14px}.hero{position:relative;min-height:100svh;isolation:isolate;display:flex;flex-direction:column;overflow:hidden}.visual{position:absolute;inset:0;z-index:-2;width:100%;height:100%;pointer-events:none}.veil{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,var(--bg),transparent 90%);opacity:.6}.nav{margin:0 5vw;min-height:100px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid color-mix(in srgb,var(--ink) 18%,transparent);gap:20px}.brand{font-size:21px;letter-spacing:-1px;font-weight:700}.brand i{font-style:normal;color:var(--accent)}.links{display:flex;align-items:center;gap:32px;font-size:12px}.nav-cta{border:1px solid color-mix(in srgb,var(--ink) 35%,transparent);padding:12px 19px;border-radius:30px}.hero-content{width:90%;max-width:1400px;margin:auto;flex:1;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:80px 0;position:relative}.eyebrow{font-size:10px;letter-spacing:2.3px;line-height:1.8;margin:0 0 30px;color:var(--accent);font-weight:600}h1{font-size:clamp(58px,7.5vw,126px);line-height:.96;letter-spacing:-.07em;font-weight:500;margin:0 0 30px;max-width:1050px}h1 br{display:block}.intro{font-size:clamp(15px,1.2vw,18px);line-height:1.8;max-width:430px;opacity:.78;margin:0 0 32px}.primary{display:inline-flex;align-items:center;justify-content:center;gap:22px;min-height:52px;padding:16px 25px;background:var(--accent);color:var(--bg);border:1px solid transparent;border-radius:40px;font-size:12px;font-weight:700;transition:transform .2s,filter .2s}.primary:hover{transform:translateY(-3px);filter:brightness(1.1)}.hero-bottom{margin:0 5vw;padding:24px 0;display:flex;align-items:center;justify-content:space-between;border-top:1px solid color-mix(in srgb,var(--ink) 18%,transparent);font-size:10px;letter-spacing:1.4px;gap:16px}.motion-control{font-size:10px;letter-spacing:1px;border:0;background:transparent;color:inherit;padding:10px}.panel{display:none}.signup{display:flex;gap:8px;border:1px solid #ffffff35;border-radius:40px;background:#090707a6;padding:6px;max-width:460px;width:100%}.signup input{background:transparent;border:0;color:inherit;min-width:0;flex:1;padding:0 14px;width:100px}.signup .primary{min-height:46px;padding:12px 21px;white-space:nowrap}.status{min-height:20px;font-size:12px;line-height:1.6}.section{padding:110px 5vw;max-width:1600px;margin:auto}.section h2{font-size:clamp(36px,5vw,70px);letter-spacing:-.055em;font-weight:500;max-width:850px;line-height:1.08;margin:0 0 48px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.feature{padding:30px 0;border-top:1px solid color-mix(in srgb,var(--ink) 25%,transparent)}.feature .number{font-size:11px;color:var(--accent)}.feature h3{font-size:25px;font-weight:500;letter-spacing:-.04em;margin:32px 0 14px}.feature p{font-size:14px;line-height:1.9;opacity:.65;max-width:320px}.closing{margin:0 5vw;padding:65px 0;border-top:1px solid color-mix(in srgb,var(--ink) 20%,transparent);display:flex;justify-content:space-between;align-items:center;gap:30px}.closing h2{font-size:clamp(30px,4vw,58px);font-weight:500;letter-spacing:-.05em;margin:0 0 16px}.closing p{opacity:.65;font-size:13px}.footer{padding:30px 5vw;display:flex;justify-content:space-between;font-size:10px;opacity:.65;gap:15px;border-top:1px solid color-mix(in srgb,var(--ink) 15%,transparent)}.demo{font-size:11px;line-height:1.7;opacity:.6}\n/* Each art direction has a different composition, not a palette duplicate. */\n.smoke .visual{--smoke-glow:var(--accent);--smoke-deep:#4c0310}.smoke .hero-content{align-items:center;text-align:center}.smoke h1{font-size:clamp(64px,8vw,132px)}.smoke .intro{max-width:470px}.smoke .veil{background:radial-gradient(ellipse at 50% 40%,transparent,#090707 95%);opacity:.5}.smoke .nav{border:0}.smoke .brand{font-style:italic}\n.orbit h1{font-size:clamp(55px,6.5vw,100px);max-width:800px}.orbit .hero-content{padding-right:25%}.orbit .panel{display:block;position:absolute;right:0;bottom:10%;width:225px;background:#0b152dce;backdrop-filter:blur(12px);border:1px solid #7ea7ff40;border-radius:16px;padding:22px}.panel small{font-size:10px;letter-spacing:1px;color:var(--accent)}.panel strong{display:block;font-size:30px;font-weight:400;margin:15px 0}.panel p{font-size:11px;line-height:1.7;opacity:.65}.orbit .primary{border-radius:9px}\n.ribbon .nav{border-color:#24251f30}.ribbon .hero-content{justify-content:flex-end;padding-bottom:100px}.ribbon h1{font-family:Georgia,serif;font-style:italic;font-size:clamp(74px,10vw,160px);letter-spacing:-.065em;max-width:900px}.ribbon .intro{margin-left:52%;max-width:350px}.ribbon .primary{margin-left:52%;background:transparent;color:var(--ink);border-color:var(--ink);border-radius:0}.ribbon .eyebrow{color:var(--ink)}.ribbon .veil{opacity:0}.ribbon .section h2{font-family:Georgia,serif}\n.signal .hero{background-image:linear-gradient(#a8efb005 1px,transparent 1px),linear-gradient(90deg,#a8efb005 1px,transparent 1px);background-size:64px 64px}.signal .brand,.signal .eyebrow,.signal .hero-bottom{font-family:monospace}.signal h1{font-size:clamp(54px,6.4vw,100px);max-width:760px}.signal .hero-content{padding-right:30%}.signal .panel{display:block;position:absolute;right:0;top:26%;width:30%;border:1px solid #a8efb038;background:#08140ee8;padding:28px;box-shadow:16px 16px 0 #a8efb00a}.signal .panel strong{font:13px/2 monospace;white-space:pre-line}.signal .primary{border-radius:3px}.signal .nav-cta{border-radius:3px}\n.wave .hero-content{align-items:center;text-align:center}.wave h1{font-family:Georgia,serif;font-style:italic;font-size:clamp(66px,9vw,145px);font-weight:400}.wave .intro{max-width:450px}.wave .eyebrow{border:1px solid #ffd27c50;padding:8px 18px;border-radius:30px}.wave .veil{background:linear-gradient(0deg,#1c130c,transparent 45%,#1c130c);opacity:.6}.wave .brand{font-family:Georgia,serif;font-weight:400;font-size:28px}\n.architecture .hero-content{justify-content:flex-end;align-items:flex-start;padding-bottom:75px}.architecture h1{font-size:clamp(80px,11vw,176px);text-transform:uppercase;font-weight:400;letter-spacing:-.08em;line-height:.85}.architecture .intro{position:absolute;right:0;bottom:100px;max-width:290px}.architecture .primary{border-radius:0;background:transparent;color:var(--ink);border-color:var(--ink);margin-top:10px}.architecture .veil{background:linear-gradient(90deg,#151b20,transparent 65%);opacity:.65}.architecture .brand{text-transform:uppercase;font-size:15px;letter-spacing:3px}.architecture .eyebrow{font-size:9px}\n@media(prefers-reduced-motion:no-preference){.hero-content{animation:arrive .9s ease both}@keyframes arrive{from{opacity:0;translate:0 15px}to{opacity:1;translate:0 0}}}html[data-motion=paused] *{animation-play-state:paused!important}html[data-motion=paused]{scroll-behavior:auto}@media(prefers-reduced-motion:reduce){:root{scroll-behavior:auto}*,*:before,*:after{animation:none!important;transition:none!important}}\n@media(min-width:1700px){.hero-content{width:90%;max-width:none}}@media(max-width:800px){.nav{min-height:80px}.links{gap:18px}.links a:not(.nav-cta){display:none}.hero-content{padding:65px 0}.grid{grid-template-columns:1fr;gap:5px}.section{padding:75px 6vw}.section h2{margin-bottom:25px}.feature h3{margin-top:20px}.closing{flex-direction:column;align-items:flex-start}.orbit .hero-content,.signal .hero-content{padding-right:0}.orbit .panel,.signal .panel{position:relative;top:auto;right:auto;bottom:auto;width:100%;max-width:400px;margin-top:32px}.orbit h1,.signal h1{font-size:clamp(48px,9vw,80px)}.ribbon .intro,.ribbon .primary{margin-left:0}.ribbon .hero-content{padding-bottom:55px}.architecture .intro{position:static;margin-bottom:22px;max-width:350px}.architecture h1{margin-bottom:30px}.hero-bottom{font-size:9px;letter-spacing:.6px}.footer{flex-direction:column}.nav-cta{font-size:10px;padding:10px 14px}}@media(max-width:420px){h1{font-size:54px!important}.hero-content{padding:55px 0}.brand{font-size:18px}.architecture .brand{font-size:12px;letter-spacing:1px}.signup{flex-direction:column;padding:7px;border-radius:22px}.signup input{min-height:43px;width:100%;flex:none}.signup .primary{width:100%}.hero-bottom>span{max-width:180px;line-height:1.7}.intro{font-size:14px}.section h2{font-size:37px}}\n</style></head><body class=\"architecture\" data-preview-state=\"loading\"><a class=\"skip\" href=\"#main\">Skip to content</a><main><section class=\"hero\" aria-labelledby=\"headline\"><canvas class=\"visual\" aria-hidden=\"true\"></canvas><div class=\"veil\"></div><nav class=\"nav\" aria-label=\"Main\"><a class=\"brand\" href=\"#\">Monument<i> /</i></a><div class=\"links\"><a href=\"#explore\">The approach</a><a href=\"#contact\">Let's talk</a><a class=\"nav-cta\" href=\"#explore\">Discover more ↗</a></div></nav><div class=\"hero-content\" id=\"main\"><p class=\"eyebrow\">ARCHITECTURE / INTERIORS / OBJECTS</p><h1 id=\"headline\">Space.<br>With intention.</h1><p class=\"intro\">We shape quiet places for a world in motion. Architecture guided by light, material, and the way people really live.</p><a class=\"primary\" href=\"#explore\">Discover the practice <span aria-hidden=\"true\">↗</span></a></div><div class=\"hero-bottom\"><span>ORIGINAL MIGBITS DESIGN / MONUMENT SPACES</span><button class=\"motion-control\" type=\"button\" aria-pressed=\"false\">Pause motion</button><a href=\"#explore\" aria-label=\"Scroll to the approach\">SCROLL ↓</a></div></section><section class=\"section\" id=\"explore\"><p class=\"eyebrow\">THE APPROACH</p><h2>Considered from every angle.</h2><div class=\"grid\"><article class=\"feature\"><span class=\"number\">01 /</span><h3>Spaces for living</h3><p>Start with a clear point of view. Create space for better questions and thoughtful decisions.</p></article><article class=\"feature\"><span class=\"number\">02 /</span><h3>Materials that last</h3><p>Bring the details together in a coherent experience. Every interaction has a reason to be here.</p></article><article class=\"feature\"><span class=\"number\">03 /</span><h3>Designed around you</h3><p>Make something you can keep building on. A strong foundation leaves room for what comes next.</p></article></div></section><section class=\"closing\" id=\"contact\"><div><p class=\"eyebrow\">YOUR NEXT CHAPTER</p><h2>Let's make it happen.</h2><p class=\"demo\">Frontend demonstration. Replace the content and connect your own services.</p></div><a class=\"primary\" href=\"mailto:hello@example.com\">Start a conversation ↗</a></section></main><footer class=\"footer\"><span>© 2026 Monument Spaces. A MigBits template.</span><span>Original design & procedural artwork · MIT · No external assets</span><a href=\"#main\">Back to top ↑</a></footer><script>\n\n(()=>{const canvas=document.querySelector('canvas'),ctx=canvas.getContext('2d'),root=document.documentElement,media=matchMedia('(prefers-reduced-motion:reduce)'),button=document.querySelector('.motion-control'),mode=\"architecture\";let frame=0,time=0,last=0,drawn=0,paused=false,parentPaused=false;canvas.width=960;canvas.height=640;const smoke=mode==='smoke'?createSmoke(canvas):null;\nfunction draw(){if(!ctx)return;const w=canvas.width,h=canvas.height,t=time;ctx.clearRect(0,0,w,h);const accent=getComputedStyle(root).getPropertyValue('--accent').trim();ctx.strokeStyle=accent;ctx.fillStyle=accent;ctx.lineWidth=1;\nif(mode==='smoke'){if(smoke){smoke.palette();smoke.render(time);return}for(let i=0;i<10;i++){const x=w*(.5+.3*Math.sin(t*.11+i*.7)),y=h*(.6+.25*Math.cos(t*.09+i*.8)),r=180+35*Math.sin(t*.17+i);const g=ctx.createRadialGradient(x,y,0,x,y,r);g.addColorStop(0,accent);g.addColorStop(1,'transparent');ctx.globalAlpha=.12;ctx.fillStyle=g;ctx.fillRect(0,0,w,h)}}\nelse if(mode==='orbit'){ctx.save();ctx.translate(w*.77,h*.48);for(let i=0;i<5;i++){ctx.save();ctx.rotate(t*.025+i*.36);ctx.globalAlpha=.22;ctx.beginPath();ctx.ellipse(0,0,110+i*39,190+i*25,.4,0,Math.PI*2);ctx.stroke();const a=t*(.16+i*.025)+i;ctx.globalAlpha=.9;ctx.beginPath();ctx.arc(Math.cos(a)*(110+i*39),Math.sin(a)*(190+i*25),i===2?7:3,0,Math.PI*2);ctx.fill();ctx.restore()}ctx.restore()}\nelse if(mode==='ribbon'){ctx.save();ctx.translate(w*.73,h*.38);for(let i=0;i<45;i++){ctx.save();ctx.rotate(Math.sin(t*.08)*.25+i*.022);ctx.globalAlpha=.26;ctx.beginPath();ctx.ellipse(0,0,90+i*2,140+i*2,0,0,Math.PI*2);ctx.stroke();ctx.restore()}ctx.restore()}\nelse if(mode==='signal'){ctx.globalAlpha=.5;for(let i=0;i<36;i++){const x=w*.52+(i%6)*76,y=90+Math.floor(i/6)*88;ctx.beginPath();ctx.arc(x,y,2+Math.sin(t*.8+i)*1.2,0,Math.PI*2);ctx.fill();if(i%6<5){ctx.globalAlpha=.12;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+76,y);ctx.stroke();ctx.globalAlpha=.5}const shift=(t*24+i*19)%76;ctx.globalAlpha=.6;ctx.fillRect(x+shift,y-1,5,2)}}\nelse if(mode==='wave'){for(let i=0;i<72;i++){const x=i*w/71,v=30+Math.pow(Math.sin(i*.13+t*.35),2)*95+Math.sin(i*.41+t*.6)*20;ctx.globalAlpha=.15+Math.sin(i*.1+t*.2)*.08;ctx.fillRect(x,h*.5-v,3,v*2)}ctx.globalAlpha=.15;ctx.beginPath();ctx.ellipse(w/2,h/2,330+Math.sin(t*.3)*25,180,0,0,Math.PI*2);ctx.stroke()}\nelse{ctx.save();ctx.translate(w*.7,h*.5);for(let i=0;i<22;i++){const a=i*10+Math.sin(t*.15)*12;ctx.globalAlpha=.06+i*.012;ctx.beginPath();ctx.moveTo(-130+a,240);ctx.lineTo(-130+a,-200+a*.2);ctx.lineTo(180+a*.4,-280+a*.2);ctx.lineTo(180+a*.4,160);ctx.stroke()}ctx.restore();const g=ctx.createLinearGradient(w*.4,0,w,0);g.addColorStop(0,'transparent');g.addColorStop(.6,'#c8d5de15');g.addColorStop(1,'transparent');ctx.fillStyle=g;ctx.globalAlpha=1;ctx.fillRect(0,0,w,h)}ctx.globalAlpha=1;canvas.dataset.elapsed=time.toFixed(3);canvas.dataset.frames=String(Number(canvas.dataset.frames||0)+1)}\nfunction tick(now){if(root.dataset.motion!=='running')return;if(last)time+=Math.min((now-last)/1000,.1);last=now;if(now-drawn>40){draw();drawn=now}frame=requestAnimationFrame(tick)}function policy(){cancelAnimationFrame(frame);last=0;const stop=paused||parentPaused||media.matches||document.hidden;root.dataset.motion=stop?'paused':'running';button.textContent=media.matches?'Reduced motion':paused?'Resume motion':'Pause motion';button.disabled=media.matches;button.setAttribute('aria-pressed',String(stop));draw();if(!stop)frame=requestAnimationFrame(tick)}button.onclick=()=>{paused=!paused;policy()};media.addEventListener('change',policy);document.addEventListener('visibilitychange',policy);addEventListener('message',e=>{if(e.source!==parent)return;if(e.data?.type==='migbits-motion-policy'&&typeof e.data.paused==='boolean'){parentPaused=e.data.paused;policy()}if(e.data?.type==='migbits-template-color')queueMicrotask(draw)});const form=document.querySelector('form');if(form)form.addEventListener('submit',e=>{e.preventDefault();document.querySelector('[role=status]').textContent='Demo only — no email was sent. Connect your own signup service.'});policy();document.body.dataset.previewState='rendered';})();\n</script></body></html>"
    },
