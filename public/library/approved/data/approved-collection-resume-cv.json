      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta name=\"robots\" content=\"noindex,nofollow\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none';script-src 'unsafe-inline';style-src 'unsafe-inline';img-src data:;connect-src 'none';font-src 'none';form-action 'none';base-uri 'none'\">\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Free Resume & CV Website Template (HTML) | Aisha Rahman</title>\n<meta name=\"description\" content=\"Free online resume and CV template in one HTML file. Print or save as PDF in one click, work history, skills, education, languages and references.\">\n<meta name=\"keywords\" content=\"resume website template, online CV HTML template free, printable resume template, personal CV page, free HTML template, one page website template\">\n\n\n<meta name=\"theme-color\" content=\"#1F3A5F\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<!-- Structured data for this template page. When you use the template, replace it with LocalBusiness or Organization schema for your own business (see README). -->\n\n<style>\n:root{--nv:#1F3A5F;--nv-l:#EAF0F7;--ac:#C2782F;--tx:#26303C;--mu:#66707D;--ln:#DDE3EA;--s:\"Source Serif 4\",Georgia,serif;--b:\"Public Sans\",system-ui,sans-serif}\n*,*::before,*::after{box-sizing:border-box}body{margin:0;font-family:var(--b);font-size:16px;line-height:1.6;color:var(--tx);background:#EEF1F5}\nimg{max-width:100%;height:auto;display:block}a{color:inherit}h1,h2,h3{margin:0;color:var(--nv);line-height:1.15}\n.skip{position:absolute;left:-999px}.skip:focus{left:10px;top:10px;background:var(--ac);color:#fff;padding:8px;z-index:99}:focus-visible{outline:2px solid var(--ac);outline-offset:2px}\n.bar{position:sticky;top:0;z-index:30;background:var(--nv);color:#fff}.bar .in{max-width:980px;margin:0 auto;padding:10px 22px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}\n.bar a,.bar button{background:#fff;color:var(--nv);border:0;border-radius:6px;padding:8px 14px;font:inherit;font-weight:700;font-size:14px;cursor:pointer;text-decoration:none}\n.bar .g{display:flex;gap:8px}\n.menu{display:flex;gap:18px;list-style:none;margin:0;padding:0;font-size:14px}.menu a{background:none;color:#fff;padding:0;font-weight:600}\n.burger{display:none}\n.page{max-width:980px;margin:28px auto 40px;background:#fff;box-shadow:0 20px 50px -30px rgba(31,58,95,.4);display:grid;grid-template-columns:300px 1fr}\n.side{background:var(--nv-l);padding:34px 28px}.side img{width:140px;height:140px;border-radius:50%;object-fit:cover;margin-bottom:18px;border:4px solid #fff}\n.side h2{font-size:14px;letter-spacing:.12em;text-transform:uppercase;font-family:var(--b);margin:26px 0 10px;color:var(--nv)}\n.side ul{list-style:none;padding:0;margin:0;font-size:15px}.side li{margin-bottom:8px}\n.sk{margin-bottom:10px;font-size:15px}.sk .t{height:6px;background:#fff;border-radius:3px;margin-top:4px;overflow:hidden}.sk .t i{display:block;height:100%;background:var(--nv)}\n.lang{display:flex;justify-content:space-between;font-size:15px;margin-bottom:6px}.lang span{color:var(--mu)}\n.main{padding:36px 38px}\n.main h1{font-family:var(--s);font-size:44px}.role{font-size:19px;color:var(--ac);font-weight:700;margin:4px 0 16px}\n.sum{font-size:17px;color:#3B4553;border-left:3px solid var(--ac);padding-left:14px;margin:0 0 26px}\n.main h2{font-family:var(--s);font-size:24px;border-bottom:2px solid var(--nv);padding-bottom:6px;margin:30px 0 14px}\n.job{margin-bottom:20px}.job .top{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}.job h3{font-size:18px;font-family:var(--b)}\n.job .co{color:var(--ac);font-weight:600}.job time{color:var(--mu);font-size:14px;white-space:nowrap}\n.job ul{margin:8px 0 0;padding-left:18px}.job li{margin-bottom:4px}\n.edu{display:flex;justify-content:space-between;gap:10px;margin-bottom:10px;flex-wrap:wrap}.edu b{display:block}.edu span{color:var(--mu);font-size:15px}\n.refs{display:grid;grid-template-columns:1fr 1fr;gap:14px}.refs div{background:var(--nv-l);border-radius:8px;padding:14px;font-size:15px}.refs b{display:block;color:var(--nv)}\n.note{max-width:980px;margin:0 auto 40px;padding:0 22px;color:var(--mu);font-size:14px;text-align:center}\n@media(max-width:820px){.page{grid-template-columns:1fr;margin:0}.main{padding:26px 22px}.refs{grid-template-columns:1fr}.menu{display:none}}\n@media print{body{background:#fff}.bar,.note,#template-bar,.skip{display:none!important}.page{box-shadow:none;margin:0;max-width:none}a{text-decoration:none}@page{margin:12mm}}\n\n</style>\n<style>\nhtml{scroll-behavior:smooth;scroll-padding-top:80px}body{overflow-x:clip}img{object-fit:cover}\nbody[data-mb-template-edition]{font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n:focus-visible{outline:3px solid #367aff!important;outline-offset:4px}\n.mb-template-motion{position:fixed;bottom:16px;right:16px;z-index:2000;background:#10213c;color:white;border:1px solid #9bbcff66;border-radius:30px;padding:9px 14px;font:12px system-ui;box-shadow:0 5px 24px #0003}\n.mb-template-status{font:13px/1.5 system-ui;color:inherit;margin-top:12px}\n.mb-template-icon{display:inline-block;width:1em;height:1em;vertical-align:-.12em}\n.mb-template-icon svg{width:100%;height:100%;fill:currentColor}\n.mb-template-art{max-width:100%;height:auto}\n.mb-template-zoom{max-width:min(1000px,92vw);border:0;border-radius:14px;padding:10px;background:#101827;color:white}\n.mb-template-zoom::backdrop{background:#050a15ce}.mb-template-zoom img{max-width:100%;max-height:80vh}.mb-template-zoom button{display:block;margin:6px 0 6px auto}\n@media(hover:hover) and (prefers-reduced-motion:no-preference){.btn{transition:box-shadow .25s,filter .25s}.btn:hover{filter:brightness(1.06);box-shadow:0 6px 20px #0002}.card,.portfolio-item{transition:box-shadow .3s}.card:hover,.portfolio-item:hover{box-shadow:0 12px 32px #1636671c}}\nhtml[data-template-motion=paused] *{animation-play-state:paused!important;transition:none!important;scroll-behavior:auto!important}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head>\n<body data-mb-template-edition data-preview-state=\"loading\">\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n<!-- Template notice bar: delete this block before you publish your own site -->\n\n<div class=\"bar\"><div class=\"in\"><ul class=\"menu\" id=\"menu\"><li><a href=\"#experience\">Experience</a></li><li><a href=\"#education\">Education</a></li><li><a href=\"#references\">References</a></li></ul><div class=\"g\"><button type=\"button\" id=\"pr\">Print or save as PDF</button><a href=\"mailto:aisha.rahman@example.com\">Email me</a></div><button class=\"burger\" aria-label=\"Menu\" aria-controls=\"menu\" aria-expanded=\"false\" hidden></button></div></div>\n<main id=\"main\"><article class=\"page\" aria-labelledby=\"h1\">\n<aside class=\"side\"><img src=\"data:image/svg+xml;base64,\" alt=\"Original MigBits geometric demo artwork\" width=\"140\" height=\"140\">\n<h2>Contact</h2><ul><li>📍 Manchester, UK</li><li>✉️ aisha.rahman@example.com</li><li>📞 +44 7700 900 123</li><li>🔗 linkedin.com/in/aisharahman</li></ul>\n<h2>Skills</h2><div class=\"sk\">Project management<div class=\"t\"><i style=\"width:95%\"></i></div></div><div class=\"sk\">Budget planning<div class=\"t\"><i style=\"width:88%\"></i></div></div><div class=\"sk\">Team leadership<div class=\"t\"><i style=\"width:90%\"></i></div></div><div class=\"sk\">Data analysis (Excel, SQL)<div class=\"t\"><i style=\"width:78%\"></i></div></div><div class=\"sk\">Stakeholder reporting<div class=\"t\"><i style=\"width:85%\"></i></div></div>\n<h2>Languages</h2><div class=\"lang\">English<span>Native</span></div><div class=\"lang\">Bengali<span>Native</span></div><div class=\"lang\">Arabic<span>Good</span></div><div class=\"lang\">French<span>Basic</span></div>\n<h2>Certificates</h2><ul><li>PMP, Project Management Institute, 2021</li><li>PRINCE2 Practitioner, 2019</li><li>Agile Scrum Master, 2018</li></ul></aside>\n<div class=\"main\"><h1 id=\"h1\">Aisha Rahman</h1><div class=\"role\">Senior Project Manager</div>\n<p class=\"sum\">Project manager with 12 years of experience leading construction and public-sector projects worth up to £40 million. Known for calm leadership, clear reporting and bringing projects in on time and under budget.</p>\n<h2 id=\"experience\">Work experience</h2>\n<div class=\"job\"><div class=\"top\"><h3>Senior Project Manager · <span class=\"co\">Northgate Infrastructure</span></h3><time>2021 to present</time></div><ul><li>Lead a team of 14 across 6 projects with a combined value of £96 million.</li><li>Delivered the £38m Riverside school build 5 weeks early and 3% under budget.</li><li>Introduced weekly risk reviews that cut late changes by 40%.</li></ul></div>\n<div class=\"job\"><div class=\"top\"><h3>Project Manager · <span class=\"co\">City of Leeds Council</span></h3><time>2016 to 2021</time></div><ul><li>Managed 22 housing and road projects for the council's regeneration plan.</li><li>Built a reporting dashboard now used by 5 departments.</li></ul></div>\n<div class=\"job\"><div class=\"top\"><h3>Assistant Project Manager · <span class=\"co\">Hale Construction</span></h3><time>2013 to 2016</time></div><ul><li>Supported budgets, schedules and supplier contracts on commercial builds.</li></ul></div>\n<h2 id=\"education\">Education</h2>\n<div class=\"edu\"><div><b>MSc Construction Project Management</b><span>University of Manchester</span></div><span>2012 to 2013</span></div>\n<div class=\"edu\"><div><b>BSc Civil Engineering, First Class</b><span>University of Leeds</span></div><span>2009 to 2012</span></div>\n<h2 id=\"references\">References</h2>\n<div class=\"refs\"><div><b>David Kerr</b>Director, Northgate Infrastructure<br>david.kerr@example.com</div><div><b>Elena Marsh</b>Head of Regeneration, City of Leeds<br>Available on request</div></div></div>\n</article></main>\n<p class=\"note\">Online CV template, a <a href=\"https://mmrahmanbappi.github.io/100-free-html-templates/\">free HTML template</a>. Photo: <a href=\"https://unsplash.com\" rel=\"noopener\">Unsplash</a>. The print button hides this note and the menu bar. © <span id=\"yr\">2026</span></p>\n<script>document.getElementById('pr').onclick=()=>window.print();</script>\n<script>\n(()=>{const b=document.querySelector('.burger'),m=document.getElementById('menu'),y=document.getElementById('yr');\nif(b&&m){b.addEventListener('click',()=>{const o=m.classList.toggle('open');b.setAttribute('aria-expanded',o)});\nm.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{m.classList.remove('open');b.setAttribute('aria-expanded',false)}))}\nif(y)y.textContent=new Date().getFullYear()})();\n</script>\n<script>\n(()=>{\nconst media=matchMedia('(prefers-reduced-motion:reduce)'),active=new Set(),seen=new WeakSet();let paused=false,lastFocus=null;\nconst toggle=document.createElement('button');toggle.className='mb-template-motion';toggle.type='button';document.body.append(toggle);\nconst observer=new IntersectionObserver(entries=>{for(const entry of entries){if(!entry.isIntersecting||paused||media.matches)continue;observer.unobserve(entry.target);if(seen.has(entry.target))continue;seen.add(entry.target);const a=entry.target.animate([{opacity:.78,translate:'0 16px'},{opacity:1,translate:'0 0'}],{duration:700,easing:'cubic-bezier(.16,1,.3,1)'});active.add(a);a.finished.finally(()=>active.delete(a)).catch(()=>{});}},{threshold:.1});\nfunction policy(){const stop=paused||media.matches;document.documentElement.dataset.templateMotion=stop?'paused':'running';toggle.textContent=media.matches?'Reduced motion':paused?'Resume motion':'Pause motion';toggle.disabled=media.matches;toggle.setAttribute('aria-pressed',String(stop));if(stop){active.forEach(a=>a.cancel());active.clear();}else document.querySelectorAll('main>section,header .wrap,article,.card').forEach(el=>{if(!seen.has(el))observer.observe(el);});}\ntoggle.onclick=()=>{paused=!paused;policy()};media.addEventListener('change',policy);policy();\nfunction targetFor(button){const selector=button.getAttribute('data-bs-target')||button.getAttribute('href');return selector&&/^#[a-zA-Z][\\w-]*$/.test(selector)?document.querySelector(selector):null;}\nfunction closeModals(){document.querySelectorAll('.modal.show').forEach(el=>{el.classList.remove('show');el.style.display='none';el.setAttribute('aria-hidden','true');el.removeAttribute('aria-modal');});document.querySelectorAll('.modal-backdrop').forEach(el=>el.remove());lastFocus?.focus();lastFocus=null;}\ndocument.addEventListener('click',event=>{\nconst trigger=event.target.closest('[data-bs-toggle],[data-bs-dismiss]');if(trigger){const kind=trigger.getAttribute('data-bs-toggle'),target=targetFor(trigger);if(kind==='collapse'&&target){event.preventDefault();const show=target.classList.toggle('show');trigger.setAttribute('aria-expanded',String(show));}if(kind==='dropdown'){event.preventDefault();const menu=trigger.parentElement.querySelector('.dropdown-menu');if(menu)trigger.setAttribute('aria-expanded',String(menu.classList.toggle('show')));}if(kind==='modal'&&target){event.preventDefault();lastFocus=trigger;target.classList.add('show');target.style.display='block';target.setAttribute('aria-modal','true');target.removeAttribute('aria-hidden');target.setAttribute('role','dialog');target.tabIndex=-1;target.focus();const backdrop=document.createElement('div');backdrop.className='modal-backdrop fade show';document.body.append(backdrop);}if(trigger.hasAttribute('data-bs-dismiss'))closeModals();}\nconst anchor=event.target.closest('a');if(!anchor)return;const href=anchor.getAttribute('href')||'';\nif(anchor.dataset.mbImage){event.preventDefault();const dialog=document.createElement('dialog');dialog.className='mb-template-zoom';const close=document.createElement('button');close.type='button';close.textContent='Close image';const image=document.createElement('img');image.src=anchor.dataset.mbImage;image.alt='Original MigBits demo artwork';dialog.append(close,image);document.body.append(dialog);close.onclick=()=>dialog.close();dialog.onclose=()=>dialog.remove();dialog.showModal();return;}\nif(/^https?:|^mailto:|^tel:/.test(href)){event.preventDefault();return;}\nif(href.startsWith('#')&&!anchor.hasAttribute('data-bs-toggle'))document.querySelectorAll('.navbar-collapse.show').forEach(el=>{el.classList.remove('show');document.querySelectorAll('.navbar-toggler').forEach(button=>button.setAttribute('aria-expanded','false'));});\n});\ndocument.addEventListener('keydown',event=>{if(event.key==='Escape')closeModals();if(event.key==='Tab'){const modal=document.querySelector('.modal.show');if(!modal)return;const focus=[...modal.querySelectorAll('button,a[href],input,select,textarea,[tabindex=\"0\"]')].filter(el=>!el.disabled&&el.getClientRects().length);if(!focus.length){event.preventDefault();modal.focus();return;}const first=focus[0],last=focus[focus.length-1];if(event.shiftKey&&(document.activeElement===first||document.activeElement===modal)){event.preventDefault();last.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}}});\ndocument.addEventListener('submit',event=>{event.preventDefault();let status=event.target.querySelector('[role=status]');if(!status){status=document.createElement('p');status.setAttribute('role','status');status.className='mb-template-status';event.target.append(status);}status.textContent='Demo only — no information has been sent. Connect your own form backend.';});\ndocument.querySelectorAll('form [type=submit]').forEach(button=>{button.disabled=false;button.classList.remove('disabled')});\ndocument.body.dataset.previewState='rendered';\n})();</script></body>\n</html>\n",
