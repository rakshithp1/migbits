:24px;border-radius:50%;background:var(--cb);color:#fff;font-size:14px;display:grid;place-items:center}\n.book{perspective:1200px;display:flex;justify-content:center}.cover{width:min(330px,80vw);aspect-ratio:3/4.2;background:var(--cb);border-radius:6px 16px 16px 6px;box-shadow:inset 14px 0 0 rgba(0,0,0,.15),24px 30px 50px rgba(30,34,64,.3);transform:rotateY(-14deg);padding:34px 28px;color:#fff;display:flex;flex-direction:column;position:relative;overflow:hidden}\n.cover small{font-weight:600;letter-spacing:.06em}.cover b{font-family:var(--h);font-weight:400;font-size:42px;line-height:1.05;margin-top:18px}.cover span{margin-top:auto;font-size:15px}.cover svg{position:absolute;right:-30px;top:120px;width:220px;opacity:.9}\n.form{background:#fff;border-radius:22px;padding:24px;box-shadow:0 20px 40px rgba(30,34,64,.1)}.form label{display:block;font-weight:500;font-size:15px;margin-bottom:6px}.form input,.form select{width:100%;font:17px var(--b);padding:12px;border:2px solid var(--ln);border-radius:12px;margin-bottom:12px;color:var(--ink)}\n.btn{display:inline-block;background:var(--ink);color:#fff;text-decoration:none;font:600 17px var(--b);padding:14px 24px;border-radius:40px;border:0;cursor:pointer}.form .btn{width:100%}.btn.y{background:var(--yl);color:var(--ink)}\n.fine{font-size:14px;color:var(--gr);margin:10px 0 0}.ok{background:var(--pb);border-radius:16px;padding:16px;margin-top:12px}.ok p{margin:0 0 10px}\nsection{padding:80px 0}.sh{max-width:640px;margin-bottom:28px}.sh h2{font-size:clamp(34px,4.4vw,52px)}.sh p{color:var(--gr);margin:10px 0 0}\n.tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}.tabs button{font:600 15px var(--b);background:var(--pb);border:0;border-radius:30px;padding:9px 16px;cursor:pointer;color:var(--ink)}.tabs button[aria-pressed=true]{background:var(--ink);color:#fff}\n.page{background:#fffdf7;border:1px solid var(--ln);border-radius:8px;padding:34px 40px;max-width:760px;box-shadow:8px 8px 0 var(--pb)}.page h3{font-size:30px}.page .n{color:var(--cb2);font-weight:600;font-size:15px}.page p{color:#3E435E}\n.page .fade{position:relative;max-height:150px;overflow:hidden}.page .fade:after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:70px;background:linear-gradient(transparent,#fffdf7)}\n.stats{background:var(--ink);color:#fff}.stats .wrap{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;padding-top:34px;padding-bottom:34px}.stats b{display:block;font-family:var(--h);font-size:44px;color:var(--yl);font-weight:400}.stats span{color:#C6CAE0}\n.q{max-width:760px}.q blockquote{margin:0;font-family:var(--h);font-size:28px;line-height:1.35}.q cite{display:block;margin-top:12px;font-style:normal;color:var(--gr);font-family:var(--b);font-size:16px}\nfooter{padding:26px 0;font-size:15px;color:var(--gr);border-top:1px solid var(--ln)}footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}\n@media (max-width:900px){.hg{grid-template-columns:1fr}.stats .wrap{grid-template-columns:1fr}.page{padding:24px}}\n@media (max-width:760px){.burger{display:block}.menu{display:none;position:absolute;top:76px;left:0;right:0;background:#fff;flex-direction:column;padding:18px 22px;z-index:30}.menu.open{display:flex}.cover{transform:none}}\n@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}\n\n</style>\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n<!-- Template notice bar: delete this block before you publish your own site -->\n<div id=\"template-bar\" style=\"background:#111;color:#fff;font:500 14px/1.4 system-ui,sans-serif;text-align:center;padding:9px 16px\">Free HTML template. <a href=\"index.html\" download=\"ebook-download.html\" style=\"color:#FFD166;font-weight:700\">Download this template (free)</a> &nbsp;|&nbsp; <a href=\"https://mmrahmanbappi.github.io/100-free-html-templates/\" style=\"color:#fff\">See all free templates</a></div>\n<header><nav class=\"wrap nav\" aria-label=\"Main\"><a href=\"#\" class=\"logo\">The Calm Inbox</a><ul class=\"menu\" id=\"menu\"><li><a href=\"#preview\">Preview</a></li><li><a href=\"#get\">Get the guide</a></li></ul><button class=\"burger\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"menu\">☰</button></nav></header>\n<main id=\"main\">\n<section class=\"hero\" id=\"get\" aria-labelledby=\"h1\"><div class=\"wrap hg\"><div><h1 id=\"h1\">Get to inbox zero in 20 minutes a day.</h1><p>A free 42-page guide for busy people who spend too much of their day on email. Simple habits, ready-made replies and a weekly routine.</p>\n<ul class=\"chk\"><li>The 3-folder system that replaces 40 labels</li><li>18 copy-and-paste replies for common emails</li><li>How to say no without sounding rude</li><li>A 20-minute daily routine that sticks</li></ul>\n<form class=\"form\" id=\"df\" aria-label=\"Download the guide\"><label for=\"dn\">First name</label><input id=\"dn\" required autocomplete=\"given-name\"><label for=\"de\">Email</label><input id=\"de\" type=\"email\" required autocomplete=\"email\"><label for=\"dr\">I mostly work in</label><select id=\"dr\"><option>An office team</option><option>My own business</option><option>Remote or freelance</option><option>Something else</option></select><button class=\"btn\" type=\"submit\">Send me the free guide</button><p class=\"fine\">No spam. One helpful email a week, unsubscribe any time.</p><div class=\"ok\" id=\"ok\" hidden aria-live=\"polite\"><p id=\"okt\"></p><a class=\"btn y\" id=\"dl\" href=\"#\" download=\"the-calm-inbox-sample.txt\">Download now</a></div></form></div>\n<div class=\"book\" aria-hidden=\"true\"><div class=\"cover\"><small>FREE GUIDE</small><b>The Calm Inbox</b><svg viewBox=\"0 0 200 200\"><rect x=\"30\" y=\"50\" width=\"140\" height=\"100\" rx=\"10\" fill=\"#FFD166\"/><path d=\"M30 60l70 50 70-50\" stroke=\"#1E2240\" stroke-width=\"8\" fill=\"none\"/></svg><span>by Hannah Price</span></div></div></div></section>\n<div class=\"stats\"><div class=\"wrap\"><div><b>31,000</b><span>downloads so far</span></div><div><b>4.8 of 5</b><span>from 1,200 reader ratings</span></div><div><b>42 pages</b><span>about 45 minutes to read</span></div></div></div>\n\n<section id=\"preview\" aria-labelledby=\"p1\"><div class=\"wrap\"><div class=\"sh\"><h2 id=\"p1\">Read a little first</h2><p>Pick a chapter to see how it starts.</p></div><div class=\"tabs\" id=\"tabs\" role=\"group\" aria-label=\"Chapters\"></div><article class=\"page\" aria-live=\"polite\"><span class=\"n\" id=\"cn\"></span><h3 id=\"ch\"></h3><div class=\"fade\"><p id=\"cp\"></p></div></article></div></section>\n<section style=\"padding-top:20px\" aria-label=\"Reader comment\"><div class=\"wrap q\"><blockquote>\"I went from 2,000 unread emails to zero in a week, and I've stayed there for three months. The reply templates alone are worth it.\"</blockquote><cite>Office manager, Leeds</cite><p style=\"margin-top:26px\"><a class=\"btn\" href=\"#get\">Get the free guide</a></p></div></section>\n</main>\n<footer><div class=\"wrap\"><p>© <span id=\"yr\"></span> Hannah Price, The Calm Inbox</p><p><a href=\"https://unsplash.com\">Photos: Unsplash</a> &nbsp;|&nbsp; <a href=\"https://mmrahmanbappi.github.io/100-free-html-templates/\">More free templates</a></p></div></footer>\n<script>\n(()=>{const $=id=>document.getElementById(id);\nconst C=[[\"Chapter 1\",\"Why email feels endless\",\"Most of us check email around 15 times an hour. Every check pulls us out of real work, and it takes about 20 minutes to get properly focused again. The problem isn't the number of emails. It's that the inbox has become a to-do list that anyone in the world can add to. In this chapter we'll take that power back, one small habit at a time.\"],[\"Chapter 2\",\"The 3-folder system\",\"Forget colour-coded labels. You need three folders: Reply, Waiting and Done. Anything that takes less than two minutes, answer straight away. Anything longer goes into Reply. Anything you're waiting on goes into Waiting. Everything else goes into Done. By the end of this chapter your inbox will be empty, and it will feel strange.\"],[\"Chapter 3\",\"Saying no, kindly\",\"A short, polite no is kinder than a slow, vague maybe. Here's a reply you can use today: 'Thanks so much for thinking of me. I can't take this on right now, but I hope it goes brilliantly.' We'll look at 6 more versions for work, family and friends.\"],[\"Chapter 4\",\"The 20-minute routine\",\"Twice a day, at times you choose, open email with a timer running. Process top to bottom, using the three folders. When the timer ends, close the tab. At first this feels risky. After a week it feels like freedom.\"]];\nlet ci=0;function ch(){$('tabs').innerHTML=C.map((c,i)=>`<button type=\"button\" aria-pressed=\"${i===ci}\" data-i=\"${i}\">${c[1]}</button>`).join('');$('cn').textContent=C[ci][0];$('ch').textContent=C[ci][1];$('cp').textContent=C[ci][2]}\n$('tabs').onclick=e=>{const b=e.target.closest('button');if(!b)return;ci=+b.dataset.i;ch()};ch();\n$('df').onsubmit=e=>{e.preventDefault();$('okt').textContent=`Thanks ${$('dn').value}! We've emailed the full guide to ${$('de').value}. You can also download a sample now.`;$('dl').href='data:text/plain;charset=utf-8,'+encodeURIComponent('The Calm Inbox (sample)\\n\\n'+C.map(c=>c[0]+': '+c[1]+'\\n'+c[2]).join('\\n\\n'));$('ok').hidden=false};\n})();\n</script>\n<script>\n(()=>{const b=document.querySelector('.burger'),m=document.getElementById('menu'),y=document.getElementById('yr');\nif(b&&m){b.addEventListener('click',()=>{const o=m.classList.toggle('open');b.setAttribute('aria-expanded',o)});\nm.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{m.classList.remove('open');b.setAttribute('aria-expanded',false)}))}\nif(y)y.textContent=new Date().getFullYear()})();\n</script>\n</body>\n</html>\n",
