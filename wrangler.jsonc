{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "migbits",
  "account_id": "3dd776d32de5178c09be07c71cab983d",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    { "pattern": "migbits.com", "custom_domain": true },
    { "pattern": "www.migbits.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "migbits" }
  ]
}
