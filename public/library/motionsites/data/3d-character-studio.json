      "content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none';script-src 'unsafe-inline';style-src 'unsafe-inline';img-src 'self' data: https://migbits.com;media-src 'self' https://migbits.com;connect-src 'none';font-src 'none';form-action 'none';base-uri 'none'\"><title>MigBits / 3D Character Studio</title><style>*{box-sizing:border-box}body{margin:0;background:#080a0f;color:#edf0f6;font:14px/1.6 system-ui}a{color:inherit}button{font:inherit;cursor:pointer}button:focus-visible,a:focus-visible{outline:2px solid #9dc8ff;outline-offset:4px}.reference{height:100svh;min-height:430px;display:flex;flex-direction:column}.head{padding:15px 22px;display:flex;align-items:center;justify-content:space-between;gap:15px;border-bottom:1px solid #ffffff20;flex:none}.head h1{font-size:14px;font-weight:500;margin:0}.head p{font-size:10px;color:#a9b2c4;margin:3px 0 0}.controls{display:flex;gap:8px;flex-wrap:wrap}.controls button{border:1px solid #ffffff30;border-radius:20px;background:transparent;color:inherit;padding:7px 12px;font-size:10px}.controls button[aria-pressed=true]{background:#e9effb;color:#101521}.stage{position:relative;flex:1;min-height:0;overflow:hidden;display:grid;place-items:center}.stage img,.stage video{display:block;width:100%;height:100%;object-fit:contain;min-height:0}.stage [hidden]{display:none}.reference-foot{padding:12px 22px;display:flex;justify-content:space-between;gap:15px;font-size:10px;color:#9ca7bb;border-top:1px solid #ffffff20;flex:none}.missing{max-width:620px;padding:35px;text-align:center}.missing h2{font-size:27px;line-height:1.2;letter-spacing:-1px}.missing p{color:#aab5c9}.live-shell .head{position:relative;z-index:100;background:#080a0f}.live-shell #root{flex:1;min-height:0;overflow:auto;position:relative;background:#f8e1c8}.live-shell #root>section{min-height:100%!important;heigh