d=\"M93 161h112l24 26h156l-19 127H108Z\" fill=\"#8B6CF8\" stroke=\"#302B46\" stroke-width=\"3\"/><rect x=\"129\" y=\"218\" width=\"68\" height=\"39\" rx=\"8\" fill=\"#FFD3AE\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M143 237h39\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"356\" cy=\"92\" r=\"21\" fill=\"#DBECAD\" stroke=\"#302B46\" stroke-width=\"3\"/></g></svg></div><span class=\"eyebrow\">Workspace</span><h3>The organizer</h3><p class=\"product-price\">$32</p><button class=\"pill\" data-add-cart data-price=\"32\">Add to cart</button></article><article class=\"card project-card\" data-item data-group=\"items\" data-kind=\"everyday\"><div class=\"art\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 480 360\" fill=\"none\" role=\"img\" aria-label=\"A few good people\"><title>A few good people</title><metadata>Original Migbits illustration. Copyright (c) 2026 Migbits contributors. MIT License. Source and complete license are included in the download package.</metadata><rect width=\"480\" height=\"360\" rx=\"24\" fill=\"#F7F5FC\"/><ellipse cx=\"240\" cy=\"328\" rx=\"170\" ry=\"13\" fill=\"#E7E1F3\"/><g stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M146 236 239 112l99 124Z\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"3\" stroke-dasharray=\"6 9\"/><circle cx=\"239\" cy=\"97\" r=\"30\" fill=\"#FFD3AE\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M210 92q3-45 52-22l10 20q-21-8-31-19-9 18-31 21\" fill=\"#302B46\"/><path d=\"M228 98v2m21-2v2m-15 11q7 7 15 0\" fill=\"none\" stroke=\"#302B46\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M191 180q0-55 48-55t48 55\" fill=\"#8B6CF8\" stroke=\"#302B46\" stroke-width=\"3\"/><circle cx=\"125\" cy=\"221\" r=\"30\" fill=\"#FFD3AE\" stroke=\"#302B46\" stroke-width=\"3\"/><path d=\"M96 216q3-45 52-22l10 20q-21-8-31-19-9 18-31 21\" fill=\"#302B46\"/><path d=\"M114 222v2m21-2v2m-15 11q7 