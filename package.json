{
  "name": "pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "build:catalog": "tsx scripts/build-catalog.ts && tsx scripts/build-resource-library.ts",
    "prebuild": "npm run build:catalog",
    "predev": "npm run build:catalog",
    "pretest": "npm run build:catalog",
    "test:consumer": "tsx scripts/test-consumer.ts",
    "pretest:consumer": "npm run build:catalog",
    "test:community": "tsx scripts/test-community-pack.ts",
    "pretest:community": "npm run build:catalog",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "deploy": "npm run build:cloudflare && npm run deploy:cloudflare",
    "test:hosting": "tsx scripts/test-hosting.ts",
    "test:browser": "playwright test",
    "import:open-source": "tsx scripts/import-open-source.ts",
    "build:import-previews": "node scripts/prepare-import-preview-runtime.mjs && tsx scripts/build-import-previews.ts && tsx scripts/attribute-import-previews.ts",
    "test:import-previews": "node scripts/check-import-previews.mjs",
    "report:imports": "tsx scripts/report-imports.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
