olor:var(--bg);padding:14px}.skip:focus{top:12px}.hero{min-height:100svh;position:relative;isolation:isolate;overflow:hidden;display:flex;flex-direction:column}.visual{position:absolute;inset:0;width:100%;height:100%;z-index:-2;opacity:.5;pointer-events:none}.nav{margin:0 5vw;min-height:92px;border-bottom:1px solid color-mix(in srgb,var(--ink) 20%,transparent);display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-size:23px;font-weight:800;letter-spacing:-1px}.brand span{color:var(--accent)}.nav-links{display:flex;gap:28px;align-items:center;font-size:11px}.nav-links>a:last-child{padding:12px 20px;border:1px solid color-mix(in srgb,var(--ink) 30%,transparent);border-radius:30px}.hero-content{width:90%;margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:center;flex:1;padding:65px 0}.eyebrow{font-size:10px;letter-spacing:2px;line-height:1.8;color:var(--accent);font-weight:700;margin:0 0 26px}h1{font-size:clamp(58px,6.4vw,105px);line-height:.98;letter-spacing:-.065em;font-weight:500;margin:0 0 28px}.intro{font-size:15px;line-height:1.9;opacity:.75;max-width:390px;margin:0 0 28px}.primary{display:inline-flex;align-items:center;gap:24px;padding:17px 25px;min-height:52px;background:var(--accent);color:var(--bg);font-size:12px;font-weight:700;border-radius:8px;transition:translate .2s}.primary:hover{translate:0 -3px}.art{position:relative;min-width:0}.product{display:block;width:100%;overflow:visible;filter:drop-shadow(0 25px 20px #0002)}.hero-bottom{margin:0 5vw;border-top:1px solid color-mix(in srgb,var(--ink) 20%,transparent);padding:22px 0;display:flex;justify-content:space-between;align-items:center;font-size:9px;letter-spacing:1px;gap:20px}.motion-control{border:0;background:transparent;color:inherit;font-size:10px;padding:8px}.window-bar{display:flex;justify-content:space-between;font-size:10px;color:color-mix(in srgb,var(--ink) 55%,transparent);padding:17px 20px;border-bottom:1px solid color-mix(in srgb,var(--ink) 15%,transparent)}.app-window,.code-window,.chart-card{border:1px solid color-mix(in srgb,var(--ink) 20%,transparent);background:color-mix(in srgb,var(--bg) 90%,var(--ink));border-radius:15px;box-shadow:0 40px 90px #0003;overflow:hidden}.app-grid{display:grid;grid-template-columns:110px 1fr;min-height:360px}.app-grid aside{padding:26px 18px;font-size:11px;line-height:2.5;opacity:.5;border-right:1px solid #ffffff15}.app-grid>div{padding:30px 22px}.app-grid small{font-size:8px;letter-spacing:1.7px;color:var(--accent)}.app-grid h3{font-size:27px;letter-spacing:-1px;font-weight:400}.mini-stats{display:flex;gap:12px;margin:25px 0}.mini-stats>span{font-size:9px;padding:16px;border:1px solid #ffffff15;flex:1;min-width:0}.mini-stats strong{display:block;font-size:13px;margin-top:8px;font-weight:400}.task{display:flex;align-items:center;gap:8px;font-size:10px;padding:13px 0;border-top:1px solid #ffffff12}.task i{width:6px;height:6px;border-radius:50%;background:var(--accent)}.task em{margin-left:auto;font-style:normal;font-size:8px;opacity:.5}.node{background:#fff9;border:1px solid #153a3020;padding:25px;display:flex;align-items:center;gap:20px;border-radius:16px;box-shadow:0 15px 30px #153a3009}.node b{font-size:11px;font-weight:400;background:#1c6b5215;padding:12px;border-radius:50%}.node span{font-size:17px}.node small{display:block;font-size:11px;opacity:.6;margin-top:10px}.node i{margin-left:auto;font-style:normal}.connector{height:45px;text-align:center;color:var(--accent);font-size:28px;line-height:45px}.chart-title{font-size:33px;margin:30px 30px 20px;letter-spacing:-1px}.chart-card svg{width:100%;display:block;padding:0 20px}.chart-legend{display:flex;justify-content:space-between;padding:25px 30px;font-size:10px;opacity:.55}.security-art{height:500px;display:grid;place-items:center;position:relative}.security-art svg{width:210px;z-index:1}.security-ring{position:absolute;width:360px;height:360px;border:1px solid #90def430;border-radius:50%;box-shadow:0 0 90px #90def409}.security-ring:before{content:'';width:9px;height:9px;position:absolute;top:40px;left:50px;background:var(--accent);border-radius:50%}.security-ring.second{width:460px;height:460px;opacity:.45;rotate:90deg}.security-label{position:absolute;bottom:40px;font-size:9px;letter-spacing:3px;color:var(--accent)}pre{font:12px/2.1 Consolas,monospace;padding:25px 30px;margin:0;white-space:pre-wrap;overflow-wrap:anywhere}.token{color:var(--accent)}.string{color:#eccf9e}.muted{opacity:.4}.terminal{font:11px/2 monospace;padding:20px 30px;border-top:1px solid #ffffff18}.knowledge-art{position:relative;padding:20px}.paper{position:relative;background:#fffdf7;border:1px solid #312b2520;padding:40px;box-shadow:15px 25px 50px #312b2510;rotate:-3deg}.paper>span,.paper>small{font-size:9px;letter-spacing:1.4px;color:var(--accent)}.paper h3{font:italic 44px/1.05 Georgia,serif;margin:35px 0 20px;letter-spacing:-2px}.paper p{font-size:12px;line-height:1.8;max-width:240px;opacity:.6}.paper hr{border:0;border-top:1px solid #312b2520;margin:26px 0}.paper>div{font-size:11px;padding:12px 0}.paper>small{display:block;margin-top:30px}.paper.back{position:absolute;inset:20px;rotate:5deg;background:#ddcba8;box-shadow:none}.section{padding:100px 5vw;max-width:1600px;margin:auto}.section h2{font-size:clamp(36px,4.5vw,68px);font-weight:500;letter-spacing:-.05em;line-height:1.05;max-width:850px;margin:0 0 45px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.feature{border-top:1px solid color-mix(in srgb,var(--ink) 25%,transparent);padding:24px 0}.feature small{font-size:10px;color:var(--accent)}.feature h3{font-size:24px;font-weight:500;letter-spacing:-.04em;margin:28px 0 15px}.feature p{font-size:13px;line-height:1.9;opacity:.65;max-width:320px}.closing{margin:0 5vw;padding:60px 0;border-top:1px solid color-mix(in srgb,var(--ink) 20%,transparent);display:flex;align-items:center;justify-content:space-between;gap:30px}.closing h2{font-size:40px;font-weight:500;letter-spacing:-2px;margin:0 0 16px}.closing p{font-size:11px;line-height:1.7;max-width:500px;opacity:.6}.footer{padding:25px 5vw;display:flex;justify-content:space-between;gap:15px;font-size:10px;opacity:.6;border-top:1px solid color-mix(in srgb,var(--ink) 15%,transparent)}\n.dashboard .hero-content{grid-template-columns:.95fr 1.05fr}.dashboard h1{font-size:clamp(56px,6vw,95px)}.dashboard .app-window{transform:perspective(1200px) rotateY(-8deg) rotateX(3deg)}.workflow h1{font-family:Georgia,serif;font-style:italic}.workflow .eyebrow,.knowledge .eyebrow,.citrus .eyebrow,.street .eyebrow,.tea .eyebrow{color:var(--ink)}.workflow .primary{border-radius:30px}.analytics .hero-content{grid-template-columns:1fr;max-width:1100px;text-align:center;padding-top:45px;gap:30px}.analytics .intro{margin:0 auto 25px;max-width:510px}.analytics h1{font-size:clamp(55px,6vw,90px)}.analytics h1 br{display:none}.analytics .art{max-width:820px;width:100%;margin:auto}.analytics .chart-card svg{max-height:180px}.analytics .chart-title{font-size:22px;margin-top:20px}.analytics .window-bar{padding:12px 20px}.analytics .chart-legend{padding:15px 25px}.security .primary{background:transparent;border:1px solid var(--accent);color:var(--accent);border-radius:30px}.security h1{font-size:clamp(56px,5.7vw,92px)}.code .brand,.code .eyebrow,.code .hero-bottom{font-family:monospace}.code .primary{border-radius:0}.knowledge h1{font-family:Georgia,serif;font-style:italic;font-size:clamp(62px,7vw,108px)}.knowledge .primary{border-radius:30px}.running .hero-content{grid-template-columns:.85fr 1.15fr}.running h1{font-size:clamp(72px,7.5vw,120px);font-weight:900;font-style:italic;text-transform:uppercase;line-height:.85}.running .art{margin-left:-50px}.running .primary{border-radius:0}.running .brand{text-transform:uppercase;font-style:italic}.street .hero-content{display:block;position:relative;padding:45px 0}.street h1{font-size:clamp(85px,9vw,140px);font-weight:900;text-transform:uppercase;line-height:.84;max-width:750px}.street .intro{max-width:310px;margin-top:35px}.street .art{position:absolute;width:58%;right:-20px;top:18%;rotate:12deg}.street .primary{border-radius:0;color:#fff}.street .hero-copy{position:relative;z-index:1;pointer-events:none}.street .hero-copy a{pointer-events:auto}.street .intro{background:var(--bg)}.atelier .hero-content{grid-template-columns:1fr 1.2fr}.atelier h1{font-family:Georgia,serif;font-size:clamp(65px,7vw,105px);font-weight:400}.atelier .primary{background:transparent;border:1px solid var(--accent);color:var(--accent);border-radius:0}.atelier .art{background:radial-gradient(ellipse,#e3c4a012,transparent 70%)}.atelier .shoe{rotate:14deg}.citrus h1{font-size:clamp(80px,10vw,160px);font-weight:900;letter-spacing:-.08em;line-height:.84}.citrus .hero-content{grid-template-columns:1.2fr 1fr}.beverage{max-height:650px}.citrus .art:before{content:'SUNSHINE IN A CAN';position:absolute;left:-35px;top:50%;font-size:10px;letter-spacing:4px;rotate:-90deg;opacity:.65}.citrus .brand,.soda .brand{font-weight:900;text-transform:uppercase}.citrus .primary{border-radius:30px}.soda .hero-content{position:relative;display:grid;grid-template-columns:1fr 1fr}.soda h1{font-size:clamp(75px,9vw,145px);font-weight:900;letter-spacing:-.08em;line-height:.9}.soda .art{rotate:-15deg}.soda .primary{border-radius:30px}.soda .hero{background-image:radial-gradient(#ffffff0b 1px,transparent 1px);background-size:18px 18px}.tea h1{font-family:Georgia,serif;font-style:italic;font-size:clamp(65px,7.5vw,118px);font-weight:400}.tea .art{padding:20px;background:radial-gradient(ellipse,#b5c5a5a0,transparent 67%)}.tea .beverage{rotate:-14deg;max-height:590px}.tea .primary{border-radius:0;background:transparent;border:1px solid var(--accent);color:var(--ink)}\n@media(prefers-reduced-motion:no-preference){.hero-copy{animation:enter .9s ease both}.product{animation:float 8s ease-in-out infinite alternate}.security-ring{animation:spin 30s linear infinite}.security-ring.second{animation-direction:reverse}.node:nth-child(3){animation:float 6s ease-in-out infinite alternate}.paper:not(.back){animation:float 9s ease-in-out infinite alternate}@keyframes float{from{translate:0 -8px}to{translate:0 12px}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes enter{from{opacity:0;translate:0 15px}to{opacity:1;translate:0 0}}}html[data-motion=paused] *{animation-play-state:paused!important}html[data-motion=paused]{scroll-behavior:auto}@media(prefers-reduced-motion:reduce){:root{scroll-behavior:auto}*,*:before,*:after{animation:none!important;transition:none!important}}\n@media(max-width:900px){.hero-content,.dashboard .hero-content,.running .hero-content,.atelier .hero-content,.citrus .hero-content,.soda .hero-content{grid-template-columns:1fr;gap:40px;padding:55px 0}.nav{min-height:78px}.nav-links>a:not(:last-child){display:none}.hero-content .art{max-width:570px;width:100%;margin:0 auto}.running h1{font-size:100px}.running .art{margin-left:0}.street .hero-content{display:flex;flex-direction:column;align-items:stretch}.street .art{position:relative;top:auto;right:auto;rotate:0}.street h1{font-size:clamp(70px,15vw,120px)}.street .intro{max-width:400px}.security-art{height:420px}.security-ring{width:280px;height:280px}.security-ring.second{width:360px;height:360px}.grid{grid-template-columns:1fr;gap:8px}.closing{flex-direction:column;align-items:flex-start}.footer{flex-direction:column}.beverage{max-height:460px}.citrus .art:before{left:0}.hero-bottom{font-size:8px;letter-spacing:.4px}.hero-bottom>span{max-width:190px;line-height:1.7}.section{padding:70px 5vw}}\n@media(max-width:420px){h1,.dashboard h1,.analytics h1,.security h1,.knowledge h1,.atelier h1,.tea h1{font-size:55px}.running h1,.street h1,.citrus h1,.soda h1{font-size:76px}.nav-links>a:last-child{font-size:9px;padding:10px 13px}.brand{font-size:20px}.intro{font-size:14px}.app-grid{grid-template-columns:75px 1fr}.app-grid aside{padding:20px 8px;font-size:9px}.app-grid>div{padding:22px 12px}.app-grid h3{font-size:22px}.mini-stats>span{padding:9px}.task{font-size:9px;flex-wrap:wrap}.task em{font-size:8px}.node{padding:20px 15px;gap:12px}.node span{font-size:14px}.node small{font-size:10px}.security-ring.second{width:280px;height:280px}.security-ring{width:220px;height:220px}.security-art{height:350px}.paper{padding:27px}.paper h3{font-size:36px}pre{font-size:10px;padding:23px 17px}.terminal{padding:17px;font-size:10px}.chart-title{font-size:23px}.chart-legend{font-size:8px;gap:10px}.closing h2{font-size:34px}.citrus .art:before{display:none}}\n</style></head><body class=\"knowledge\" data-preview-state=\"loading\"><a class=\"skip\" href=\"#main\">Skip to content</a><main><section class=\"hero\" aria-labelledby=\"headline\"><canvas class=\"visual\" aria-hidden=\"true\"></canvas><nav class=\"nav\" aria-label=\"Main\"><a class=\"brand\" href=\"#main\">Papertrail<span> /</span></a><div class=\"nav-links\"><a href=\"#explore\">The platform</a><a href=\"#contact\">Our story</a><a href=\"#explore\">Take a closer look ↗</a></div></nav><div class=\"hero-content\" id=\"main\"><div class=\"hero-copy\"><p class=\"eyebrow\">A HOME FOR YOUR TEAM'S THINKING</p><h1 id=\"headline\">Good thinking<br>deserves a home.</h1><p class=\"intro\">A living library of ideas, notes and shared knowledge. Find the thread. Follow your curiosity.</p><a class=\"primary\" href=\"#explore\">Open the library <span aria-hidden=\"true\">↗</span></a></div><div class=\"art\"><div class=\"knowledge-art\"><div class=\"paper back\"></div><div class=\"paper\"><span>THE SHARED NOTEBOOK</span><h3>Follow the<br>interesting thread.</h3><p>A place for the thoughts that become something bigger.</p><hr><div>↗ Ideas worth keeping</div><div>↗ The team's reading list</div><div>↗ What we're learning</div><small>LESS SEARCHING. MORE FINDING.</small></div></div></div></div><div class=\"hero-bottom\"><span>SOFTWARE / ORIGINAL MIGBITS CONCEPT</span><button class=\"motion-control\" type=\"button\" aria-pressed=\"false\">Pause motion</button><a href=\"#explore\">EXPLORE ↓</a></div></section><section class=\"section\" id=\"explore\"><p class=\"eyebrow\">A DIFFERENT WAY FORWARD</p><h2>Make room for better work.</h2><div class=\"grid\"><article class=\"feature\"><small>01 / THE APPROACH</small><h3>Capture the thought</h3><p>Bring the essentials into focus. A clearer starting point helps your whole team find its direction.</p></article><article class=\"feature\"><small>02 / THE APPROACH</small><h3>Connect the dots</h3><p>Thoughtful details connect the experience. Keep useful context close to the work that needs it.</p></article><article class=\"feature\"><small>03 / THE APPROACH</small><h3>Find it again</h3><p>Build on a foundation that leaves room for change. Make your next step a considered one.</p></article></div></section><section class=\"closing\" id=\"contact\"><div><p class=\"eyebrow\">PAPERTRAIL KNOWLEDGE</p><h2>Start with a better foundation.</h2><p>Fictional brand and illustrative product concept. Frontend template only; no real software service or SDK is included. Replace example content before launch.</p></div><a class=\"primary\" href=\"mailto:hello@example.com\">Get in touch ↗</a></section></main><footer class=\"footer\"><span>© 2026 Papertrail Knowledge / Original MigBits design</span><span>MIT · Original SVG artwork · No external assets</span><a href=\"#main\">Back to top ↑</a></footer><script>\n(()=>{const root=document.documentElement,canvas=document.querySelector('canvas'),ctx=canvas.getContext('2d'),media=matchMedia('(prefers-reduced-motion:reduce)'),button=document.querySelector('.motion-control'),mode=\"knowledge\";canvas.width=960;canvas.height=640;let time=0,last=0,drawn=0,frame=0,paused=false,parentPaused=false;function draw(){if(!ctx)return;ctx.clearRect(0,0,960,640);ctx.strokeStyle=getComputedStyle(root).getPropertyValue('--accent').trim();ctx.fillStyle=ctx.strokeStyle;ctx.lineWidth=1;const seed=mode.length;for(let i=0;i<18;i++){const x=480+Math.sin(i*1.7+time*.08)*420,y=320+Math.cos(i*.9+time*.11)*290;ctx.globalAlpha=.06+(i%4)*.025;ctx.beginPath();ctx.arc(x,y,2+(i%3),0,Math.PI*2);ctx.fill();if(i%3===0){ctx.beginPath();ctx.ellipse(700,320,110+i*15,90+i*12,Math.sin(time*.045+seed)*.4,0,Math.PI*2);ctx.stroke()}}ctx.globalAlpha=1;canvas.dataset.elapsed=time.toFixed(3);canvas.dataset.frames=String(Number(canvas.dataset.frames||0)+1)}function tick(now){if(root.dataset.motion!=='running')return;if(last)time+=Math.min((now-last)/1000,.1);last=now;if(now-drawn>40){draw();drawn=now}frame=requestAnimationFrame(tick)}function policy(){cancelAnimationFrame(frame);last=0;const stop=paused||parentPaused||media.matches||document.hidden;root.dataset.motion=stop?'paused':'running';button.textContent=media.matches?'Reduced motion':paused?'Resume motion':'Pause motion';button.disabled=media.matches;button.setAttribute('aria-pressed',String(stop));draw();if(!stop)frame=requestAnimationFrame(tick)}button.onclick=()=>{paused=!paused;policy()};media.addEventListener('change',policy);document.addEventListener('visibilitychange',policy);addEventListener('message',e=>{if(e.source!==parent)return;if(e.data?.type==='migbits-motion-policy'&&typeof e.data.paused==='boolean'){parentPaused=e.data.paused;policy()}if(e.data?.type==='migbits-template-color')queueMicrotask(draw)});policy();document.body.dataset.previewState='rendered';})();\n</script></body></html>"
