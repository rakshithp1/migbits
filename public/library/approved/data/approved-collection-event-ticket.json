      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta name=\"robots\" content=\"noindex,nofollow\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none';script-src 'unsafe-inline';style-src 'unsafe-inline';img-src data:;connect-src 'none';font-src 'none';form-action 'none';base-uri 'none'\">\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Free Event Ticket Page Template (HTML) | Night Market Live</title>\n<meta name=\"description\" content=\"Free single event ticket page template in one HTML file. Line-up, doors countdown, ticket tiers with quantity picker, promo code, fees and a live total.\">\n<meta name=\"keywords\" content=\"event ticket page template, concert landing page HTML free, event registration page template, ticket sales page, free HTML template, one page website template\">\n\n\n<meta name=\"theme-color\" content=\"#1A0B2E\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<!-- Structured data for this template page. When you use the template, replace it with LocalBusiness or Organization schema for your own business (see README). -->\n\n<style>\n:root{--dp:#1A0B2E;--dp2:#26123F;--dp3:#3A1E5C;--pk:#FF2E88;--cy:#00E5FF;--tx:#F2EAFB;--mu:#B6A6CC;--h:\"Monoton\",Impact,sans-serif;--b:\"Golos Text\",system-ui,sans-serif}\n*,*::before,*::after{box-sizing:border-box}[hidden]{display:none!important}html{scroll-behavior:smooth}body{margin:0;font-family:var(--b);font-size:17px;line-height:1.6;color:var(--tx);background:var(--dp)}\nimg{max-width:100%;height:auto;display:block}a{color:inherit}h1,h2,h3{margin:0;line-height:1}h1,h2{font-family:var(--h);font-weight:400}\n.wrap{max-width:1180px;margin:0 auto;padding:0 22px}.skip{position:absolute;left:-999px}.skip:focus{left:10px;top:10px;background:var(--cy);color:#000;padding:8px;z-index:99}\n:focus-visible{outline:3px solid var(--cy);outline-offset:3px}\n.nav{display:flex;justify-content:space-between;align-items:center;height:76px;position:relative}.logo{font-weight:700;text-decoration:none;font-size:19px}.logo span{color:var(--pk)}\n.menu{display:flex;gap:24px;list-style:none;margin:0;padding:0}.menu a{text-decoration:none}.menu a:hover{color:var(--cy)}.burger{display:none;background:none;border:2px solid var(--tx);color:var(--tx);width:44px;height:40px;font-size:20px;cursor:pointer}\n.hero{position:relative;overflow:hidden;min-height:620px;display:flex;align-items:flex-end}.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.45}.hero:after{content:\"\";position:absolute;inset:0;background:linear-gradient(0deg,var(--dp) 5%,transparent 70%)}\n.hc{position:relative;z-index:2;padding:60px 0}.date{display:inline-block;border:2px solid var(--cy);color:var(--cy);border-radius:40px;padding:6px 16px;font-weight:700;margin-bottom:20px}\n.hero h1{font-size:clamp(54px,9vw,130px);color:#fff;text-shadow:0 0 30px rgba(255,46,136,.6)}.hero p{font-size:20px;color:var(--mu);max-width:32em;margin:18px 0 24px}\n.cd{display:flex;gap:10px;flex-wrap:wrap}.cd div{background:rgba(26,11,46,.8);border:1px solid var(--dp3);border-radius:14px;padding:10px 14px;text-align:center;min-width:80px}.cd b{display:block;font-size:30px;color:var(--pk)}.cd span{font-size:13px;color:var(--mu)}\n.btn{display:inline-block;background:var(--pk);color:#fff;text-decoration:none;font:700 17px var(--b);padding:14px 26px;border-radius:40px;border:0;cursor:pointer}\nsection{padding:80px 0}.sh h2{font-size:clamp(38px,5vw,66px);color:var(--cy);margin-bottom:12px}.sh p{color:var(--mu);margin:0 0 30px;max-width:34em}\n.lu{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.act{border:1px solid var(--dp3);border-radius:18px;padding:22px;background:var(--dp2)}.act .t{color:var(--pk);font-weight:700}.act h3{font-size:30px;margin:8px 0 6px;font-weight:700}.act p{margin:0;color:var(--mu);font-size:15px}.act.head{grid-column:span 3;background:linear-gradient(120deg,var(--dp3),var(--dp2))}.act.head h3{font-size:clamp(34px,5vw,56px)}\n.tx .g{display:grid;grid-template-columns:1.2fr .8fr;gap:30px;align-items:start}.tx .g>div{min-width:0}\n.tier{display:grid;grid-template-columns:1fr auto;gap:10px 20px;align-items:center;border:1px solid var(--dp3);border-radius:18px;padding:20px;margin-bottom:12px;background:var(--dp2)}.tier h3{font-size:22px}.tier p{margin:4px 0 0;color:var(--mu);font-size:15px}.tier .pr{font-size:26px;font-weight:700;color:var(--cy)}\n.tier.so{opacity:.55}.tier .left{font-size:13px;color:var(--pk);font-weight:700}\n.qt{display:flex;align-items:center;gap:10px;grid-column:2}.qt button{width:40px;height:40px;border-radius:50%;border:2px solid var(--cy);background:transparent;color:var(--cy);font-size:20px;cursor:pointer}.qt button:disabled{opacity:.35;cursor:not-allowed}.qt output{font-weight:700;font-size:20px;min-width:22px;text-align:center}\n.sum{background:var(--tx);color:var(--dp);border-radius:22px;padding:24px;position:sticky;top:16px}.sum h3{font-size:24px}.sum ul{list-style:none;padding:0;margin:14px 0}.sum li{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px dashed #CBBFDA;font-size:15px}\n.promo{display:flex;gap:8px;margin:8px 0 4px}.promo input{flex:1;min-width:0;font:16px var(--b);padding:10px 12px;border:1px solid #CBBFDA;border-radius:10px}.promo button{font:700 15px var(--b);background:var(--dp);color:#fff;border:0;border-radius:10px;padding:0 14px;cursor:pointer}.promo label{position:absolute;left:-999px}\n.pm{font-size:14px;min-height:20px;margin:0 0 8px}.tot{display:flex;justify-content:space-between;align-items:baseline;margin:10px 0 14px}.tot b{font-size:38px}\n.sum .btn{width:100%;text-align:center}.sum .btn:disabled{opacity:.5;cursor:not-allowed}.msg{visibility:hidden;margin:10px 0 0;font-weight:700;color:#B0126A;font-size:15px}.msg.on{visibility:visible}\n.info .g2{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.info h3{font-size:22px;color:var(--pk);margin-bottom:8px}.info p{margin:0;color:var(--mu)}\nfooter{border-top:1px solid var(--dp3);padding:26px 0;font-size:15px;color:var(--mu)}footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}\n@media (max-width:960px){.tx .g{grid-template-columns:minmax(0,1fr)}.tx .g>*{min-width:0}.sum{position:static}.lu{grid-template-columns:1fr 1fr}.act.head{grid-column:span 2}.info .g2{grid-template-columns:1fr}}\n.tier>div{min-width:0}\n@media (max-width:760px){.tier{grid-template-columns:1fr auto;padding:16px}.qt{grid-column:1/-1}.burger{display:block}.menu{display:none;position:absolute;top:76px;left:0;right:0;background:var(--dp2);flex-direction:column;padding:18px 22px;z-index:30}.menu.open{display:flex}.lu{grid-template-columns:1fr}.act.head{grid-column:span 1}.cd div{min-width:68px}}\n\n</style>\n<style>\nhtml{scroll-behavior:smooth;scroll-padding-top:80px}body{overflow-x:clip}img{object-fit:cover}\nbody[data-mb-template-edition]{font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n:focus-visible{outline:3px solid #367aff!important;outline-offset:4px}\n.mb-template-motion{position:fixed;bottom:16px;right:16px;z-index:2000;background:#10213c;color:white;border:1px solid #9bbcff66;border-radius:30px;padding:9px 14px;font:12px system-ui;box-shadow:0 5px 24px #0003}\n.mb-template-status{font:13px/1.5 system-ui;color:inherit;margin-top:12px}\n.mb-template-icon{display:inline-block;width:1em;height:1em;vertical-align:-.12em}\n.mb-template-icon svg{width:100%;height:100%;fill:currentColor}\n.mb-template-art{max-width:100%;height:auto}\n.mb-template-zoom{max-width:min(1000px,92vw);border:0;border-radius:14px;padding:10px;background:#101827;color:white}\n.mb-template-zoom::backdrop{background:#050a15ce}.mb-template-zoom img{max-width:100%;max-height:80vh}.mb-template-zoom button{display:block;margin:6px 0 6px auto}\n@media(hover:hover) and (prefers-reduced-motion:no-preference){.btn{transition:box-shadow .25s,filter .25s}.btn:hover{filter:brightness(1.06);box-shadow:0 6px 20px #0002}.card,.portfolio-item{transition:box-shadow .3s}.card:hover,.portfolio-item:hover{box-shadow:0 12px 32px #1636671c}}\nhtml[data-template-motion=paused] *{animation-play-state:paused!important;transition:none!important;scroll-behavior:auto!important}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head>\n<body data-mb-template-edition data-preview-state=\"loading\">\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n<!-- Template notice bar: delete this block before you publish your own site -->\n\n<header><nav class=\"wrap nav\" aria-label=\"Main\"><a href=\"#\" class=\"logo\">Night Market <span>Live</span></a><ul class=\"menu\" id=\"menu\"><li><a href=\"#lineup\">Line-up</a></li><li><a href=\"#tickets\">Tickets</a></li><li><a href=\"#info\">Info</a></li></ul><button class=\"burger\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"menu\">☰</button></nav></header>\n<main id=\"main\">\n<section class=\"hero\" style=\"padding:0\" aria-labelledby=\"h1\"><img src=\"data:image/svg+xml;base64,\" alt=\"Original MigBits geometric demo artwork\" width=\"2000\" height=\"1333\" fetchpriority=\"high\"><div class=\"wrap hc\"><span class=\"date\">Saturday 14 November, doors 6pm</span><h1 id=\"h1\">Night Market Live</h1><p>One night of live music, street food and neon under the railway arches in East Austin. Five bands, 20 food stalls, one very big disco ball.</p>\n<div class=\"cd\" aria-label=\"Countdown to doors\"><div><b id=\"cD\">0</b><span>days</span></div><div><b id=\"cH\">0</b><span>hours</span></div><div><b id=\"cM\">0</b><span>minutes</span></div></div><p style=\"margin:22px 0 0\"><a class=\"btn\" href=\"#tickets\">Get tickets</a></p></div></section>\n\n<section id=\"lineup\" aria-labelledby=\"l1\"><div class=\"wrap\"><div class=\"sh\"><h2 id=\"l1\">Line-up</h2><p>Stage times go up a week before. Headliner plays at 10:15pm.</p></div>\n<div class=\"lu\"><div class=\"act head\"><span class=\"t\">Headliner</span><h3>Glass Coyote</h3><p>Synth-pop with a full brass section. Their first Austin show in three years.</p></div><div class=\"act\"><span class=\"t\">9pm</span><h3>Paper Rivers</h3><p>Dreamy guitar pop.</p></div><div class=\"act\"><span class=\"t\">8pm</span><h3>DJ Marisol</h3><p>Cumbia, disco and funk.</p></div><div class=\"act\"><span class=\"t\">7pm</span><h3>The Sun Rooms</h3><p>Four-piece soul band.</p></div></div></div></section>\n\n<section class=\"tx\" id=\"tickets\" aria-labelledby=\"t1\"><div class=\"wrap\"><div class=\"sh\"><h2 id=\"t1\">Tickets</h2><p>Up to 8 tickets per order. Under 12s go free with an adult.</p></div>\n<div class=\"g\"><div id=\"tiers\"></div>\n<aside class=\"sum\" aria-live=\"polite\"><h3>Your order</h3><ul id=\"sl\"><li><span>No tickets yet</span><span></span></li></ul><div class=\"promo\"><label for=\"pc\">Promo code</label><input id=\"pc\" placeholder=\"Promo code\"><button type=\"button\" id=\"pa\">Apply</button></div><p class=\"pm\" id=\"pm\"></p>\n<div class=\"tot\"><span>Total</span><b id=\"tt\">$0</b></div><button class=\"btn\" type=\"button\" id=\"buy\" disabled>Checkout</button><p class=\"msg\" id=\"msg\" role=\"status\"></p></aside></div></div></section>\n\n<section class=\"info\" id=\"info\" aria-labelledby=\"i1\"><div class=\"wrap\"><div class=\"sh\"><h2 id=\"i1\">Good to know</h2></div><div class=\"g2\"><div><h3>Where</h3><p>The Arches, 1100 E 5th St, Austin, TX. Five minutes from Plaza Saltillo station.</p></div><div><h3>Age</h3><p>All ages. Under 21s get a wristband and can't buy alcohol. Photo ID needed at the bar.</p></div><div><h3>Refunds</h3><p>Full refund up to 7 days before. After that, you can transfer your ticket to a friend for free.</p></div></div></div></section>\n</main>\n<footer><div class=\"wrap\"><p>© <span id=\"yr\"></span> Night Market Live</p><p><a href=\"https://unsplash.com\">Photos: Unsplash</a> &nbsp;|&nbsp; <a href=\"https://mmrahmanbappi.github.io/100-free-html-templates/\">More free templates</a></p></div></footer>\n<script>\n(()=>{const $=id=>document.getElementById(id);const D=new Date('2026-11-14T18:00:00');\nfunction cd(){const s=Math.max(0,Math.floor((D-new Date())/1000));$('cD').textContent=Math.floor(s/86400);$('cH').textContent=Math.floor(s%86400/3600);$('cM').textContent=Math.floor(s%3600/60)}cd();setInterval(cd,30000);\nconst T=[[\"Early bird\",\"General entry, limited release\",29,0,0],[\"General admission\",\"Entry from 6pm, standing\",39,120,0],[\"Front of stage\",\"Own area near the stage, fast lane entry\",65,18,0],[\"VIP deck\",\"Raised deck, 2 drinks, private bar and toilets\",110,6,0]];let promo=0;\nfunction tiers(){const tot=T.reduce((a,t)=>a+t[4],0);$('tiers').innerHTML=T.map((t,i)=>{const so=t[3]===0;return`<div class=\"tier${so?' so':''}\"><div><h3>${t[0]}</h3><p>${t[1]}</p>${so?'<span class=\"left\">Sold out</span>':t[3]<20?`<span class=\"left\">Only ${t[3]} left</span>`:''}</div><span class=\"pr\">$${t[2]}</span><div class=\"qt\" role=\"group\" aria-label=\"${t[0]} tickets\"><button type=\"button\" data-i=\"${i}\" data-d=\"-1\" aria-label=\"Remove one\" ${t[4]===0?'disabled':''}>−</button><output>${t[4]}</output><button type=\"button\" data-i=\"${i}\" data-d=\"1\" aria-label=\"Add one\" ${so||tot>=8||t[4]>=t[3]?'disabled':''}>+</button></div></div>`}).join('');sum()}\nfunction sum(){const L=T.filter(t=>t[4]).map(t=>[`${t[4]} x ${t[0]}`,t[4]*t[2]]);const sub=L.reduce((a,l)=>a+l[1],0),n=T.reduce((a,t)=>a+t[4],0),fee=n*3.5,disc=sub*promo;\n$('sl').innerHTML=L.length?L.map(l=>`<li><span>${l[0]}</span><span>$${l[1]}</span></li>`).join('')+`<li><span>Booking fee ($3.50 each)</span><span>$${fee.toFixed(2)}</span></li>`+(promo?`<li><span>Promo discount</span><span>−$${disc.toFixed(2)}</span></li>`:''):'<li><span>No tickets yet</span><span></span></li>';\nconst t=sub+fee-disc;$('tt').textContent='$'+(t%1?t.toFixed(2):t);$('buy').disabled=!n}\n$('tiers').onclick=e=>{const b=e.target.closest('button');if(!b||b.disabled)return;const t=T[+b.dataset.i];t[4]=Math.max(0,t[4]+ +b.dataset.d);tiers()};\n$('pa').onclick=()=>{const c=$('pc').value.trim().toUpperCase();if(c==='ARCHES10'){promo=.1;$('pm').textContent='Code applied: 10% off tickets.'}else{promo=0;$('pm').textContent=c?'That code is not valid. Try ARCHES10.':''}sum()};\n$('buy').onclick=()=>{$('msg').textContent='In your own site, this button would open your ticket checkout.';$('msg').classList.add('on')};T[1][4]=2;tiers();\n})();\n</script>\n<script>\n(()=>{const b=document.querySelector('.burger'),m=document.getElementById('menu'),y=document.getElementById('yr');\nif(b&&m){b.addEventListener('click',()=>{const o=m.classList.toggle('open');b.setAttribute('aria-expanded',o)});\nm.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{m.classList.remove('open');b.setAttribute('aria-expanded',false)}))}\nif(y)y.textContent=new Date().getFullYear()})();\n</script>\n<script>\n(()=>{\nconst media=matchMedia('(prefers-reduced-motion:reduce)'),active=new Set(),seen=new WeakSet();let paused=false,lastFocus=null;\nconst toggle=document.createElement('button');toggle.className='mb-template-motion';toggle.type='button';document.body.append(toggle);\nconst observer=new IntersectionObserver(entries=>{for(const entry of entries){if(!entry.isIntersecting||paused||media.matches)continue;observer.unobserve(entry.target);if(seen.has(entry.target))continue;seen.add(entry.target);const a=entry.target.animate([{opacity:.78,translate:'0 16px'},{opacity:1,translate:'0 0'}],{duration:700,easing:'cubic-bezier(.16,1,.3,1)'});active.add(a);a.finished.finally(()=>active.delete(a)).catch(()=>{});}},{threshold:.1});\nfunction policy(){const stop=paused||media.matches;document.documentElement.dataset.templateMotion=stop?'paused':'running';toggle.textContent=media.matches?'Reduced motion':paused?'Resume motion':'Pause motion';toggle.disabled=media.matches;toggle.setAttribute('aria-pressed',String(stop));if(stop){active.forEach(a=>a.cancel());active.clear();}else document.querySelectorAll('main>section,header .wrap,article,.card').forEach(el=>{if(!seen.has(el))observer.observe(el);});}\ntoggle.onclick=()=>{paused=!paused;policy()};media.addEventListener('change',policy);policy();\nfunction targetFor(button){const selector=button.getAttribute('data-bs-target')||button.getAttribute('href');return selector&&/^#[a-zA-Z][\\w-]*$/.test(selector)?document.querySelector(selector):null;}\nfunction closeModals(){document.querySelectorAll('.modal.show').forEach(el=>{el.classList.remove('show');el.style.display='none';el.setAttribute('aria-hidden','true');el.removeAttribute('aria-modal');});document.querySelectorAll('.modal-backdrop').forEach(el=>el.remove());lastFocus?.focus();lastFocus=null;}\ndocument.addEventListener('click',event=>{\nconst trigger=event.target.closest('[data-bs-toggle],[data-bs-dismiss]');if(trigger){const kind=trigger.getAttribute('data-bs-toggle'),target=targetFor(trigger);if(kind==='collapse'&&target){event.preventDefault();const show=target.classList.toggle('show');trigger.setAttribute('aria-expanded',String(show));}if(kind==='dropdown'){event.preventDefault();const menu=trigger.parentElement.querySelector('.dropdown-menu');if(menu)trigger.setAttribute('aria-expanded',String(menu.classList.toggle('show')));}if(kind==='modal'&&target){event.preventDefault();lastFocus=trigger;target.classList.add('show');target.style.display='block';target.setAttribute('aria-modal','true');target.removeAttribute('aria-hidden');target.setAttribute('role','dialog');target.tabIndex=-1;target.focus();const backdrop=document.createElement('div');backdrop.className='modal-backdrop fade show';document.body.append(backdrop);}if(trigger.hasAttribute('data-bs-dismiss'))closeModals();}\nconst anchor=event.target.closest('a');if(!anchor)return;const href=anchor.getAttribute('href')||'';\nif(anchor.dataset.mbImage){event.preventDefault();const dialog=document.createElement('dialog');dialog.className='mb-template-zoom';const close=document.createElement('button');close.type='button';close.textContent='Close image';const image=document.createElement('img');image.src=anchor.dataset.mbImage;image.alt='Original MigBits demo artwork';dialog.append(close,image);document.body.append(dialog);close.onclick=()=>dialog.close();dialog.onclose=()=>dialog.remove();dialog.showModal();return;}\nif(/^https?:|^mailto:|^tel:/.test(href)){event.preventDefault();return;}\nif(href.startsWith('#')&&!anchor.hasAttribute('data-bs-toggle'))document.querySelectorAll('.navbar-collapse.show').forEach(el=>{el.classList.remove('show');document.querySelectorAll('.navbar-toggler').forEach(button=>button.setAttribute('aria-expanded','false'));});\n});\ndocument.addEventListener('keydown',event=>{if(event.key==='Escape')closeModals();if(event.key==='Tab'){const modal=document.querySelector('.modal.show');if(!modal)return;const focus=[...modal.querySelectorAll('button,a[href],input,select,textarea,[tabindex=\"0\"]')].filter(el=>!el.disabled&&el.getClientRects().length);if(!focus.length){event.preventDefault();modal.focus();return;}const first=focus[0],last=focus[focus.length-1];if(event.shiftKey&&(document.activeElement===first||document.activeElement===modal)){event.preventDefault();last.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}}});\ndocument.addEventListener('submit',event=>{event.preventDefault();let status=event.target.querySelector('[role=status]');if(!status){status=document.createElement('p');status.setAttribute('role','status');status.className='mb-template-status';event.target.append(status);}status.textContent='Demo only — no information has been sent. Connect your own form backend.';});\ndocument.querySelectorAll('form [type=submit]').forEach(button=>{button.disabled=false;button.classList.remove('disabled')});\ndocument.body.dataset.previewState='rendered';\n})();</script></body>\n</html>\n",
